{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "bun run build",
	"installCommand": "bun install",
	"framework": "astro",
	"redirects": [
		{
			"source": "/home2",
			"destination": "/",
			"permanent": true
		},
		{
			"source": "/home2/",
			"destination": "/",
			"permanent": true
		},
		{
			"source": "/courses",
			"destination": "/online-courses/",
			"permanent": true
		},
		{
			"source": "/courses/",
			"destination": "/online-courses/",
			"permanent": true
		},
		{
			"source": "/registration",
			"destination": "/sign-up/",
			"permanent": false
		},
		{
			"source": "/registration/",
			"destination": "/sign-up/",
			"permanent": false
		},
		{
			"source": "/profile",
			"destination": "/account/",
			"permanent": false
		},
		{
			"source": "/profile/",
			"destination": "/account/",
			"permanent": false
		},
		{
			"source": "/reset-password",
			"destination": "/sign-in/",
			"permanent": false
		},
		{
			"source": "/reset-password/",
			"destination": "/sign-in/",
			"permanent": false
		}
	]
}
