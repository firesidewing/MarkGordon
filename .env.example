# =============================================================================
# Phase 2 — Clerk + Turso setup
# Copy this file to `.env` and fill in values when ready.
# The site builds without these; course checkout and lesson gating need them.
# =============================================================================

# --- Clerk (https://dashboard.clerk.com) ---
# Create an application → API Keys
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Webhooks → Add Endpoint → URL: https://www.markgordon.ca/api/webhooks/clerk
# Subscribe to: subscription.created, subscription.updated, subscription.active,
#              subscriptionItem.active, subscriptionItem.updated
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# --- Clerk Billing (Dashboard → Billing → Plans) ---
# Create four one-time user plans. Set each plan slug to match the course slug:
#   relationship-matters                    ($79)
#   godfidence-building-confidence-that-lasts-forever ($29)
#   understanding-anger                     ($29)
#   punching-shame-in-the-face              ($29)
# Copy each plan ID (cplan_…) below:
CLERK_PLAN_RELATIONSHIP_MATTERS=cplan_...
CLERK_PLAN_GODFIDENCE=cplan_...
CLERK_PLAN_UNDERSTANDING_ANGER=cplan_...
CLERK_PLAN_PUNCHING_SHAME=cplan_...

# --- Turso (https://turso.tech) ---
# 1. turso db create markgordon-courses
# 2. turso db tokens create markgordon-courses
# 3. bun --env-file=.env run db:migrate
#    (or: turso db shell markgordon-courses < scripts/turso-schema.sql)
TURSO_DATABASE_URL=libsql://...
TURSO_AUTH_TOKEN=...
