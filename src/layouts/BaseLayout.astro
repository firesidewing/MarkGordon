---
import { ClientRouter } from 'astro:transitions';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import SEO from '@/components/seo/SEO.astro';
import { site } from '@/config/site';
import { pageTransition } from '@/utils/page-transition';
import '@/styles/global.css';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	publishedTime?: string;
	noindex?: boolean;
}

const {
	title = site.name,
	description = site.tagline,
	image,
	type = 'website',
	publishedTime,
	noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<SEO
			title={title}
			description={description}
			image={image}
			type={type}
			publishedTime={publishedTime}
			noindex={noindex}
		/>
		<ClientRouter />
	</head>
	<body class="flex min-h-screen flex-col">
		<div id="nav-progress" class="nav-progress" aria-hidden="true" transition:persist="nav-progress">
			<div class="nav-progress__bar"></div>
		</div>
		<a href="#main-content" class="skip-link">Skip to content</a>
		<Header transition:persist="site-header" />
		<main id="main-content" class="flex-1" transition:animate={pageTransition}>
			<slot />
		</main>
		<Footer transition:persist="site-footer" />
	</body>
</html>

<script>
	import { initNavigationProgress } from '@/scripts/navigation-progress';
	initNavigationProgress();
</script>
