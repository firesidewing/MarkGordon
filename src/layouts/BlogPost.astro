---
import YouTube from '@/components/islands/YouTube.svelte';
import BlogSidebar from '@/components/ui/BlogSidebar.astro';
import Card from '@/components/ui/Card.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import {
	categoryUrl,
	formatDate,
	getCategoryCounts,
	getPublishedPosts,
	getRelatedPosts,
} from '@/utils/content';
import { youtubeOgImage } from '@/utils/seo';
import { site } from '@/config/site';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, date, categories = [], videoId, excerpt } = post.data;

const [allPosts, categoryCounts] = await Promise.all([getPublishedPosts(), getCategoryCounts()]);
const relatedPosts = getRelatedPosts(post, allPosts);
const recentPosts = allPosts.filter((entry) => entry.id !== post.id).slice(0, 5);
---

<BaseLayout
	title={title}
	description={excerpt ?? `${title} — relationship insights from ${site.name}.`}
	type="article"
	publishedTime={date.toISOString()}
	image={videoId ? youtubeOgImage(videoId) : undefined}
>
	<div class="mx-auto w-full max-w-content px-4 py-section sm:px-6 lg:px-8">
		<div class="lg:grid lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] lg:gap-12 xl:gap-16">
			<article class="min-w-0">
				<header class="mb-8 border-b border-surface-muted pb-8">
					<h1 class="font-display text-2xl font-h2 uppercase tracking-h2 text-brand sm:text-3xl">
						{title}
					</h1>
					<div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-text-subtle">
						<time datetime={date.toISOString()}>{formatDate(date)}</time>
						{
							categories.length > 0 && (
								<ul class="flex flex-wrap gap-2" role="list">
									{
										categories.map((category) => (
											<li>
												<a
													href={categoryUrl(category)}
													class="rounded-sm bg-surface-muted px-2.5 py-0.5 text-xs font-medium uppercase tracking-wide text-text-muted transition-colors hover:bg-brand hover:text-text-inverse"
												>
													{category}
												</a>
											</li>
										))
									}
								</ul>
							)
						}
					</div>
				</header>

				{videoId && (
					<div class="mb-8">
						<YouTube videoId={videoId} title={title} />
					</div>
				)}

				<div class="prose prose-neutral max-w-none prose-headings:font-display prose-a:text-brand prose-a:no-underline hover:prose-a:underline">
					<slot />
				</div>

				{
					relatedPosts.length > 0 && (
						<section class="mt-12 border-t border-surface-muted pt-10">
							<h2 class="mb-6 font-display text-h2 font-h2 uppercase tracking-h2 text-brand">Related Posts</h2>
							<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
								{
									relatedPosts.map((related) => (
										<Card
											title={related.data.title}
											slug={related.data.slug}
											date={related.data.date}
											excerpt={related.data.excerpt}
										/>
									))
								}
							</div>
						</section>
					)
				}
			</article>

			<BlogSidebar categories={categoryCounts} recentPosts={recentPosts} />
		</div>
	</div>
</BaseLayout>
