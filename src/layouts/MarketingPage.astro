---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import HubSpotCTA from '@/components/ui/HubSpotCTA.astro';
import Section from '@/components/ui/Section.astro';

interface Props {
	title: string;
	description?: string;
	intro?: string;
	heroImage?: ImageMetadata;
	featuredImage?: ImageMetadata;
	heroLayout?: 'centered' | 'split';
	contentLayout?: 'default' | 'image-left';
	showHero?: boolean;
	showSidebar?: boolean;
	image?: string;
	noindex?: boolean;
}

const {
	title,
	description,
	intro,
	heroImage,
	featuredImage,
	heroLayout = 'centered',
	contentLayout = 'default',
	showHero = true,
	showSidebar = false,
	image,
	noindex = false,
} = Astro.props;
---

<BaseLayout
	title={title}
	description={description ?? intro}
	image={image}
	noindex={noindex}
>
	{
		showHero && (
			<PageHero
				title={title}
				intro={intro}
				image={heroImage}
				imageAlt={title}
				centered={heroLayout === 'centered' && !heroImage}
			/>
		)
	}

	<Section>
		<div
			class:list={[
				showSidebar &&
					'lg:grid lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-12 xl:grid-cols-[minmax(0,1fr)_20rem] xl:gap-16',
			]}
		>
			{
				contentLayout === 'image-left' && featuredImage ? (
					<div class="grid items-start gap-10 lg:grid-cols-[minmax(0,280px)_1fr] lg:gap-12 xl:grid-cols-[minmax(0,320px)_1fr]">
						<div class="overflow-hidden rounded-sm shadow-sm">
							<Image
								src={featuredImage}
								alt={title}
								width={featuredImage.width}
								height={featuredImage.height}
								class="h-auto w-full object-cover"
								loading="eager"
							/>
						</div>
						<article class="prose prose-neutral max-w-none min-w-0 prose-headings:font-display prose-headings:text-text-heading prose-a:text-brand prose-a:no-underline hover:prose-a:underline">
							<slot />
						</article>
					</div>
				) : (
					<article class="prose prose-neutral max-w-none min-w-0 prose-headings:font-display prose-headings:text-text-heading prose-a:text-brand prose-a:no-underline hover:prose-a:underline">
						<slot />
					</article>
				)
			}

			{
				showSidebar && (
					<aside class="mt-10 lg:mt-0">
						<slot name="sidebar">
							<HubSpotCTA class="sticky top-28" />
						</slot>
					</aside>
				)
			}
		</div>
	</Section>
</BaseLayout>
