---
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
	title: string;
	description?: string;
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
	<slot name="hero" />
	<slot />
</BaseLayout>
