---
import BlogSidebar from '@/components/ui/BlogSidebar.astro';
import Card from '@/components/ui/Card.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCategoryCounts, type CollectionEntry } from '@/utils/content';
import type { Page } from 'astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
	page?: Page;
	activeCategory?: string;
}

const { posts, page, activeCategory } = Astro.props;
const categoryCounts = await getCategoryCounts();

const pageTitle = activeCategory ? `${activeCategory} — Blog` : 'Blog';
const description = 'Relationship insights, encouragement, and practical wisdom from Mark Gordon.';
---

<BaseLayout title={pageTitle} description={description}>
	<section class="bg-brand py-12 text-center sm:py-16">
		<div class="container-site">
			<h1 class="font-display text-2xl font-[var(--font-weight-h2)] uppercase tracking-h2 text-text-inverse sm:text-3xl">
				{activeCategory ?? 'Blog'}
			</h1>
			<p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-text-inverse/90">
				{
					activeCategory
						? `Posts in the ${activeCategory} category.`
						: 'Weekly insights on building stronger relationships at home, at work, and in community.'
				}
			</p>
		</div>
	</section>

	<div class="container-site py-[var(--spacing-section)]">
		<div class="lg:grid lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] lg:gap-12 xl:gap-16">
			<div class="min-w-0">
				{
					posts.length > 0 ? (
						<div class="grid gap-6 sm:grid-cols-2">
							{
								posts.map((post) => (
									<Card
										title={post.data.title}
										slug={post.data.slug}
										date={post.data.date}
										excerpt={post.data.excerpt}
									/>
								))
							}
						</div>
					) : (
						<p class="text-text-muted">No posts found.</p>
					)
				}

				{
					page && page.lastPage > 1 && (
						<nav class="mt-10 flex items-center justify-center gap-4" aria-label="Blog pagination">
							{
								page.url.prev ? (
									<a
										href={page.url.prev}
										class="rounded-[var(--radius-button)] border border-brand px-5 py-2 text-sm font-semibold uppercase tracking-wide text-brand transition-colors hover:bg-brand hover:text-text-inverse"
									>
										← Previous
									</a>
								) : (
									<span class="px-5 py-2 text-sm text-text-subtle">← Previous</span>
								)
							}
							<span class="text-sm text-text-muted">
								Page {page.currentPage} of {page.lastPage}
							</span>
							{
								page.url.next ? (
									<a
										href={page.url.next}
										class="rounded-[var(--radius-button)] border border-brand px-5 py-2 text-sm font-semibold uppercase tracking-wide text-brand transition-colors hover:bg-brand hover:text-text-inverse"
									>
										Next →
									</a>
								) : (
									<span class="px-5 py-2 text-sm text-text-subtle">Next →</span>
								)
							}
						</nav>
					)
				}
			</div>

			<BlogSidebar categories={categoryCounts} activeCategory={activeCategory} />
		</div>
	</div>
</BaseLayout>
