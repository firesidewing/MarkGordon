---
import SocialIcon from '@/components/icons/SocialIcon.astro';
import { site, socialLinks } from '@/config/site';
---

<div class="bg-brand text-text-inverse">
	<div class="mx-auto flex h-11 w-full max-w-content items-center justify-between px-4 sm:px-6 lg:px-8">
		<a
			href={`mailto:${site.email}`}
			class="hidden min-h-11 items-center gap-2 text-xs hover:opacity-90 sm:flex"
		>
			<svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<path d="M4 4h16v16H4z" opacity="0" />
				<path d="M4 6l8 6 8-6M4 6v12h16V6" />
			</svg>
			<span>{site.email}</span>
		</a>

		<div class="flex w-full items-center justify-end gap-4 sm:w-auto">
			<ul class="hidden items-center gap-1 md:flex" role="list">
				{
					socialLinks.map((link) => (
						<li>
							<a
								href={link.href}
								class="flex min-h-11 min-w-11 items-center justify-center rounded-full text-text-inverse transition-opacity hover:opacity-80 motion-reduce:transition-none"
								target="_blank"
								rel="noopener noreferrer"
								aria-label={link.label}
							>
								<SocialIcon name={link.icon} />
							</a>
						</li>
					))
				}
			</ul>
			<a
				href="/registration/"
				class="inline-flex min-h-11 items-center font-display text-xs font-medium uppercase tracking-wide hover:opacity-90"
			>
				Login
			</a>
		</div>
	</div>
</div>
