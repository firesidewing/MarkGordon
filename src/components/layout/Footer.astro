---
import { Image } from 'astro:assets';
import SocialIcon from '@/components/icons/SocialIcon.astro';
import logo from '@/assets/logo.png';
import { footerNavLinks, site, socialLinks } from '@/config/site';
import { homeNewsletter } from '@/data/home';
---

<footer class="bg-footer text-footer-text">
	<div class="mx-auto w-full max-w-content px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
		<div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
			<div class="flex flex-col items-start">
				<a href="/" aria-label="Mark Gordon — Home">
					<Image
						src={logo}
						alt="Mark Gordon"
						width={logo.width}
						height={logo.height}
						widths={[100, 120]}
						sizes="100px"
						class="h-auto w-[100px] brightness-0 invert"
						loading="lazy"
					/>
				</a>
				<p class="mt-4 max-w-xs text-sm leading-relaxed text-text-inverse/90">
					{site.footerTagline}
				</p>
			</div>

			<div>
				<h4 class="mb-4 font-display text-xs font-semibold uppercase tracking-widest text-text-inverse">
					Explore
				</h4>
				<ul class="space-y-1" role="list">
					{
						footerNavLinks.map((link) => (
							<li>
								<a
									href={link.href}
									class="link-interactive inline-flex min-h-11 items-center text-sm text-footer-text hover:text-text-inverse"
								>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<h4 class="mb-4 font-display text-xs font-semibold uppercase tracking-widest text-text-inverse">
					Connect
				</h4>
				<ul class="flex flex-wrap gap-2" role="list">
					{
						socialLinks.map((link) => (
							<li>
								<a
									href={link.href}
									class="flex min-h-11 min-w-11 items-center justify-center rounded-full bg-white/10 text-footer-text transition-colors hover:bg-brand hover:text-text-inverse motion-reduce:transition-none"
									target="_blank"
									rel="noopener noreferrer"
									aria-label={link.label}
								>
									<SocialIcon name={link.icon} />
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<h4 class="mb-2 font-display text-xs font-semibold uppercase tracking-widest text-text-inverse">
					Newsletter
				</h4>
				<p class="mb-4 text-sm leading-relaxed">
					{homeNewsletter.description}
				</p>
				<a
					href="/newsletter-signup/"
					class="btn-interactive inline-flex items-center justify-center rounded-button bg-brand px-8 py-3.5 font-display text-sm text-button font-button uppercase text-text-inverse hover:bg-brand-dark"
				>
					{homeNewsletter.cta}
				</a>
			</div>
		</div>
	</div>

	<div class="border-t border-white/10">
		<div class="mx-auto flex w-full max-w-content flex-col items-center justify-between gap-3 px-4 py-5 text-xs sm:flex-row sm:px-6 lg:px-8">
			<p>{site.copyright}</p>
			<a href={`mailto:${site.email}`} class="inline-flex min-h-11 items-center transition-colors hover:text-text-inverse">
				{site.email}
			</a>
		</div>
	</div>
</footer>
