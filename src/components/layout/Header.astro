---
import { Image } from 'astro:assets';
import { Show, SignInButton, UserButton } from '@clerk/astro/components';
import MobileNav from '@/components/islands/MobileNav.svelte';
import logo from '@/assets/logo.png';
import { clerkAppearance } from '@/config/clerk-appearance';
import { mainNav, type NavItem } from '@/config/site';

const currentPath = Astro.url.pathname;

function isNavActive(item: NavItem, path: string): boolean {
	if (item.href.startsWith('/#')) return false;
	if (path === item.href) return true;
		if (item.children) {
		return item.children.some((child) => {
			if (child.external) return false;
			if (child.href.startsWith('/#')) return false;
			if (path === child.href) return true;
			if (child.href === '/online-courses/' && path.startsWith('/courses/')) return true;
			return child.href !== '/' && path.startsWith(child.href);
		});
	}
	return item.href !== '/' && path.startsWith(item.href);
}
---

<header class="sticky top-0 z-50 border-b border-surface-muted bg-surface shadow-sm">
	<div class="mx-auto flex h-[72px] w-full max-w-content items-center justify-between gap-4 px-4 sm:px-6 lg:h-20 lg:px-8">
		<a href="/" class="flex shrink-0 items-center" aria-label="Mark Gordon — Home">
			<Image
				src={logo}
				alt="Mark Gordon"
				width={logo.width}
				height={logo.height}
				widths={[100, 130, 160]}
				sizes="(max-width: 1023px) 100px, 130px"
				class="h-10 w-auto max-h-10 lg:h-12 lg:max-h-12"
				loading="eager"
			/>
		</a>

		<nav class="hidden items-center gap-0.5 xl:gap-1 lg:flex" aria-label="Main navigation">
			{
				mainNav.map((item) =>
					item.children ? (
						<div class="group relative">
							<a
								href={item.href}
								class:list={[
									'link-interactive nav-underline inline-flex min-h-11 items-center gap-1 px-2 py-2 font-display text-nav font-nav text-text-heading hover:text-brand xl:px-3',
									isNavActive(item, currentPath) && 'text-brand',
								]}
								aria-haspopup="true"
							>
								{item.label}
								<svg class="h-3 w-3 opacity-60" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
									<path d="M2.5 4.5L6 8l3.5-3.5" />
								</svg>
							</a>
							<ul
								class="invisible absolute right-0 top-full z-50 min-w-[16rem] translate-y-1 rounded-sm border border-surface-muted bg-surface py-2 opacity-0 shadow-lg transition-all motion-reduce:transition-none group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100"
								role="list"
							>
								{
									item.children.map((child) => (
										<li>
											<a
												href={child.href}
												class="link-interactive block px-4 py-2 text-sm text-text-heading hover:bg-surface-muted hover:text-brand"
												{...(child.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
											>
												{child.label}
											</a>
										</li>
									))
								}
							</ul>
						</div>
					) : (
						<a
							href={item.href}
							class:list={[
								'link-interactive nav-underline inline-flex min-h-11 items-center px-2 py-2 font-display text-nav font-nav text-text-heading hover:text-brand xl:px-3',
								isNavActive(item, currentPath) && 'text-brand',
							]}
						>
							{item.label}
						</a>
					),
				)
			}
		</nav>

		<div class="flex shrink-0 items-center gap-2">
			<Show when="signed-out">
				<SignInButton
					mode="redirect"
					forceRedirectUrl="/account/courses/"
					appearance={clerkAppearance}
					class="btn-interactive inline-flex min-h-11 items-center rounded-button bg-brand px-3 py-2 font-display text-[0.6875rem] font-medium uppercase tracking-wide text-text-inverse hover:bg-brand-dark sm:px-6 sm:text-sm"
				>
					Login
				</SignInButton>
			</Show>
			<Show when="signed-in">
				<UserButton
					appearance={clerkAppearance}
					userProfileUrl="/account/"
					afterSignOutUrl="/"
				/>
			</Show>

			<MobileNav client:media="(max-width: 1023px)" nav={mainNav} currentPath={currentPath} />
		</div>
	</div>
</header>
