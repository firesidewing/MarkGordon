---
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import { workshopsTeaser } from '@/data/keynote-speaker';

const { title, intro, topicsLabel, topics, cta, href } = workshopsTeaser;
---

<Section>
	<article class="grid gap-8 border border-surface-muted bg-surface p-6 shadow-sm sm:p-10 lg:grid-cols-2 lg:items-center">
		<div>
			<h2
				class="text-balance font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
			>
				{title}
			</h2>
			<p class="mt-4 text-base leading-relaxed text-text">{intro}</p>
			<div class="mt-8">
				<Button href={href}>{cta}</Button>
			</div>
		</div>
		<div>
			<p
				class="font-display text-[length:var(--text-eyebrow)] font-semibold uppercase tracking-[var(--tracking-eyebrow)] text-brand"
			>
				{topicsLabel}
			</p>
			<ul class="mt-4 space-y-3" role="list">
				{
					topics.map((topic) => (
						<li class="flex gap-4 border-t border-surface-muted pt-3 first:border-t-0 first:pt-0">
							<span class="font-display text-sm font-semibold text-brand" aria-hidden="true">
								→
							</span>
							<span class="text-base leading-relaxed text-text">{topic}</span>
						</li>
					))
				}
			</ul>
		</div>
	</article>
</Section>
