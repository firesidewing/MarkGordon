---
import Section from '@/components/ui/Section.astro';
import { acceleratorDifferentiators } from '@/data/leadership-accelerator';

const { title, intro, items } = acceleratorDifferentiators;
---

<Section>
	<div class="mx-auto max-w-4xl">
		<h2
			class="text-balance text-center font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
		>
			{title}
		</h2>
		<p class="mx-auto mt-4 max-w-2xl text-center text-base leading-relaxed text-text">
			{intro}
		</p>

		<div class="mt-10 grid gap-4 sm:grid-cols-2">
			{
				items.map((item) => (
					<article class="border-t-2 border-brand bg-surface-muted px-5 py-5 sm:px-6 sm:py-6">
						<h3 class="font-display text-h4 font-semibold leading-snug text-text-heading">
							{item.label}
						</h3>
						<p class="mt-3 text-sm leading-relaxed text-text sm:text-base">
							{item.description}
						</p>
					</article>
				))
			}
		</div>
	</div>
</Section>
