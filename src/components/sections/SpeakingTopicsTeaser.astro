---
import Button from "@/components/ui/Button.astro";
import Section from "@/components/ui/Section.astro";
import { homeSpeakingTopics } from "@/data/home";

const { title, intro, topics, cta, href } = homeSpeakingTopics;
---

<Section variant="muted">
    <div class="mx-auto mb-10 max-w-3xl text-center">
        <h2
            class="text-balance font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
        >
            {title}
        </h2>
        <p class="mt-4 text-base leading-relaxed text-text-muted">{intro}</p>
    </div>

    <div class="grid gap-4 lg:grid-cols-3 lg:gap-6">
        {
            topics.map((topic) => (
                <article class="border-t-2 border-brand bg-surface px-6 py-6 shadow-sm">
                    <h3 class="font-display text-h4 font-semibold leading-snug text-text-heading">
                        {topic.title}
                    </h3>
                    <p class="mt-3 text-sm leading-relaxed text-text">
                        {topic.description}
                    </p>
                </article>
            ))
        }
    </div>

    <div class="mt-10 text-center">
        <Button href={href}>{cta}</Button>
    </div>
</Section>
