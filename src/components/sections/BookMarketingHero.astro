---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	subtitle: string;
	hook: string;
	cover: ImageMetadata;
}

const { title, subtitle, hook, cover } = Astro.props;
---

<section class="bg-brand">
	<div
		class="mx-auto grid w-full max-w-content items-center gap-8 px-4 py-12 sm:px-6 lg:grid-cols-2 lg:gap-12 lg:px-8 lg:py-16"
	>
		<div>
			<p class="font-display text-xs font-semibold uppercase tracking-widest text-text-inverse/70">
				Book
			</p>
			<h1
				class="mt-3 font-display text-[clamp(2rem,4.5vw,3rem)] font-bold leading-tight text-text-inverse"
			>
				{title}
			</h1>
			<p class="mt-3 text-lg font-medium text-text-inverse/95">{subtitle}</p>
			<p class="mt-4 max-w-prose text-sm leading-relaxed text-text-inverse/85">{hook}</p>
			<div class="mt-8">
				<a
					href="#retailers"
					class="btn-interactive inline-flex min-h-11 items-center justify-center rounded-button bg-surface px-8 py-3 font-display text-button font-button uppercase text-brand hover:bg-surface-muted"
				>
					Find a retailer
				</a>
			</div>
		</div>

		<div class="flex justify-center lg:justify-end">
			<div class="overflow-hidden rounded-sm shadow-lg">
				<Image
					src={cover}
					alt={`${title} book cover`}
					width={cover.width}
					height={cover.height}
					class="h-auto w-full max-w-sm object-cover"
					loading="eager"
				/>
			</div>
		</div>
	</div>
</section>
