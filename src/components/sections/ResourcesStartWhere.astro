---
import Section from '@/components/ui/Section.astro';
import { startWhereYouAre } from '@/data/resources';

const { title, intro, links } = startWhereYouAre;
---

<Section variant="muted" id="start-here">
	<div class="mx-auto max-w-3xl text-center">
		<h2
			class="font-display text-h2 font-h2 uppercase tracking-h2 text-brand"
		>
			{title}
		</h2>
		<div class="mt-4 space-y-2 text-base leading-relaxed text-text">
			{intro.map((line) => <p>{line}</p>)}
		</div>
	</div>

	<ul class="mx-auto mt-10 flex max-w-2xl flex-col gap-4">
		{
			links.map((link) => (
				<li>
					<a
						href={link.href}
						class="card-interactive group flex flex-col gap-1 border-l-4 border-brand bg-surface px-5 py-4 shadow-sm sm:flex-row sm:items-center sm:justify-between sm:gap-4"
					>
						<span class="text-sm text-text-muted sm:text-base">{link.question}</span>
						<span
							class="font-display text-sm font-semibold uppercase tracking-wide text-brand group-hover:underline"
						>
							{link.cta} →
						</span>
					</a>
				</li>
			))
		}
	</ul>
</Section>
