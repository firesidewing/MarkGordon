---
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import { homeAcceleratorTeaser } from '@/data/leadership-accelerator';

const { eyebrow, title, description, highlights, cta, href } = homeAcceleratorTeaser;
---

<Section variant="muted">
	<article class="grid gap-8 border-t-4 border-brand bg-surface px-6 py-10 shadow-sm sm:px-10 sm:py-12 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:items-center">
		<div>
			<p
				class="font-display text-[length:var(--text-eyebrow)] font-semibold uppercase tracking-[var(--tracking-eyebrow)] text-brand"
			>
				{eyebrow}
			</p>
			<h2 class="mt-3 font-display text-h3 font-semibold leading-snug text-text-heading">
				{title}
			</h2>
			<p class="mt-4 max-w-prose text-base leading-relaxed text-text">
				{description}
			</p>
			<div class="mt-8">
				<Button href={href} external>
					{cta}
				</Button>
			</div>
		</div>
		<ul class="space-y-4" role="list">
			{
				highlights.map((highlight) => (
					<li class="flex gap-4 border-t border-surface-muted pt-4 first:border-t-0 first:pt-0">
						<span class="font-display text-sm font-semibold text-brand" aria-hidden="true">
							→
						</span>
						<span class="text-base leading-relaxed text-text">{highlight}</span>
					</li>
				))
			}
		</ul>
	</article>
</Section>
