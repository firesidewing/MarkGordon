---
import Button from '@/components/ui/Button.astro';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import Section from '@/components/ui/Section.astro';
import { hubspot } from '@/config/site';
import { signatureWorkshops, signatureWorkshopsSection, workshopsHero } from '@/data/workshops';
---

<Section
	variant="muted"
	id="signature-workshops"
	class="scroll-mt-20"
>
	<SectionHeading title={signatureWorkshopsSection.title} centered class="mb-10" />

	<div class="mx-auto max-w-4xl space-y-4">
		{
			signatureWorkshops.map((workshop) => (
				<details class="group border border-surface-muted bg-surface shadow-sm open:border-brand/30">
					<summary
						class="flex cursor-pointer list-none items-start justify-between gap-4 px-5 py-5 sm:px-6 sm:py-6 [&::-webkit-details-marker]:hidden"
					>
						<div class="min-w-0">
							<h3 class="font-display text-h4 font-semibold leading-snug text-text-heading">
								{workshop.title}
							</h3>
							{workshop.subtitle && (
								<p class="mt-1 text-sm font-medium text-brand sm:text-base">{workshop.subtitle}</p>
							)}
							<p class="mt-3 text-sm leading-relaxed text-text sm:text-base max-sm:line-clamp-2 group-open:line-clamp-none">
								{workshop.overview[0]}
							</p>
						</div>
						<span
							class="mt-1 shrink-0 text-brand transition-transform group-open:rotate-180 motion-reduce:transition-none"
							aria-hidden="true"
						>
							<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
								<path
									fill-rule="evenodd"
									d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
									clip-rule="evenodd"
								/>
							</svg>
						</span>
					</summary>

					<div class="border-t border-surface-muted px-5 pb-5 pt-4 sm:px-6 sm:pb-6">
						<div class="space-y-3 text-sm leading-relaxed text-text sm:text-base">
							{workshop.overview.slice(1).map((paragraph) => (
								<p>{paragraph}</p>
							))}
						</div>

						{workshop.participantsExplore.length > 0 && (
							<div class="mt-6">
								<p
									class="font-display text-[length:var(--text-eyebrow)] font-semibold uppercase tracking-[var(--tracking-eyebrow)] text-brand"
								>
									Participants will explore
								</p>
								<ul class="mt-3 space-y-2" role="list">
									{workshop.participantsExplore.map((item) => (
										<li class="flex gap-2.5 text-sm leading-relaxed text-text sm:text-base">
											<span
												class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"
												aria-hidden="true"
											/>
											{item}
										</li>
									))}
								</ul>
							</div>
						)}

						{workshop.note && (
							<p class="mt-6 text-sm leading-relaxed text-text-muted sm:text-base">{workshop.note}</p>
						)}

						<p class="mt-6 text-sm leading-relaxed text-text sm:text-base">
							<span class="font-semibold text-text-heading">Best for:</span> {workshop.bestFor}
						</p>

						{workshop.link && (
							<div class="mt-4">
								<a
									href={workshop.link.href}
									class="link-interactive font-display text-sm font-semibold uppercase tracking-wide text-brand hover:underline"
								>
									{workshop.link.label} →
								</a>
							</div>
						)}
					</div>
				</details>
			))
		}
	</div>

	<div class="mt-10 text-center">
		<Button href={hubspot.discoveryCall} external>
			{workshopsHero.primaryCta}
		</Button>
	</div>
</Section>
