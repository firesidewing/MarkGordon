---
import { Image } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import { hubspot } from '@/config/site';
import {
	faithCommunityCollage,
	faithCommunityHero,
	faithCommunityIntro,
} from '@/data/faith-community-packages';

const { eyebrow, title, subhead, areasIntro, primaryCta, secondaryCta, packagesAnchor } =
	faithCommunityHero;
---

<section class="bg-surface" aria-labelledby="faith-hero-heading">
	<div
		class="mx-auto w-full max-w-content px-4 py-[var(--spacing-hero-y)] pb-8 sm:px-6 sm:pb-[var(--spacing-hero-y)] lg:px-8"
	>
		<div class="grid items-start gap-10 lg:grid-cols-2 lg:gap-12">
			<div class="grid grid-cols-[0.85fr_1fr] gap-2 sm:gap-3">
				{
					faithCommunityCollage.map((column) => (
						<div class="flex flex-col gap-2 sm:gap-3">
							{column.map(({ image, size, align }) => (
								<div
									class:list={[
										size === 'small' ? 'w-[45%]' : 'w-full',
										align === 'right' && 'ml-auto',
									]}
								>
									<Image
										src={image}
										alt=""
										width={image.width}
										height={image.height}
										class="h-auto w-full"
										loading="eager"
										fetchpriority="high"
									/>
								</div>
							))}
						</div>
					))
				}
			</div>

			<div class="max-w-[var(--width-hero-copy)]">
				<p
					class="font-display text-[length:var(--text-eyebrow)] font-semibold uppercase tracking-[var(--tracking-eyebrow)] text-brand"
				>
					{eyebrow}
				</p>
				<h1
					id="faith-hero-heading"
					class="mt-2 text-balance font-display text-[length:var(--text-hero)] font-[number:var(--font-weight-hero)] leading-[var(--text-hero--line-height)] tracking-[var(--tracking-hero)] text-text-heading"
				>
					{title}
				</h1>
				<p class="mt-4 text-base leading-relaxed text-text">{subhead}</p>
				<p class="mt-4 text-base leading-relaxed text-text-muted">{areasIntro}</p>
				<ul class="mt-3 space-y-2" role="list">
					{
						faithCommunityIntro.audienceAreas.map((item) => (
							<li class="flex gap-2.5 text-base leading-relaxed text-text">
								<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true" />
								<span>{item}</span>
							</li>
						))
					}
				</ul>
				<p class="mt-4 text-base leading-relaxed text-text-muted">{faithCommunityIntro.closing}</p>
				<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
					<Button href={hubspot.discoveryCall} external class="w-full sm:w-auto">
						{primaryCta}
					</Button>
					<Button href={packagesAnchor} variant="secondary" class="w-full sm:w-auto">
						{secondaryCta}
					</Button>
				</div>
			</div>
		</div>
	</div>
</section>
