---
import { resourcesHero } from '@/data/resources';

const { eyebrow, title, subtitle, paragraphs } = resourcesHero;
---

<section class="bg-surface" aria-labelledby="resources-hero-heading">
	<div class="mx-auto w-full max-w-content px-4 py-[var(--spacing-hero-y)] sm:px-6 lg:px-8">
		<div class="mx-auto max-w-3xl text-center">
			<p
				class="font-display text-[length:var(--text-eyebrow)] font-semibold uppercase tracking-[var(--tracking-eyebrow)] text-brand"
			>
				{eyebrow}
			</p>
			<h1
				id="resources-hero-heading"
				class="mt-3 text-balance font-display text-[length:var(--text-hero)] font-[number:var(--font-weight-hero)] leading-[var(--text-hero--line-height)] tracking-[var(--tracking-hero)] text-text-heading"
			>
				{title}
			</h1>
			<p class="mt-4 text-lg leading-relaxed text-text sm:text-xl">{subtitle}</p>
			<div class="mt-6 space-y-3 text-base leading-relaxed text-text-muted">
				{paragraphs.map((paragraph) => <p>{paragraph}</p>)}
			</div>
		</div>
	</div>
</section>
