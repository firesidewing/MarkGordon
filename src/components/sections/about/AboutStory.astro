---
import { Image } from 'astro:assets';
import Section from '@/components/ui/Section.astro';
import { aboutStory } from '@/data/about-mark';
import storyImage from '@/assets/content/faith-community-packages/Mark-32-1-1024x1024.jpg';

const { title, paragraphs, insights, close } = aboutStory;
---

<Section variant="muted">
	<div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] lg:items-center lg:gap-16">
		<div>
			<h2
				class="text-balance font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
			>
				{title}
			</h2>

			<div class="mt-6 space-y-4">
				{
					paragraphs.map((paragraph) => (
						<p class="text-base leading-relaxed text-text">{paragraph}</p>
					))
				}
			</div>

			<ul class="mt-4 space-y-2" role="list">
				{
					insights.map((line) => (
						<li class="flex gap-3 text-base leading-relaxed text-text-heading">
							<span
								class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"
								aria-hidden="true"
							/>
							{line}
						</li>
					))
				}
			</ul>

			<p class="mt-6 text-base leading-relaxed text-text">{close}</p>
		</div>

		<div class="overflow-hidden">
			<Image
				src={storyImage}
				alt="Mark Gordon facilitating a leadership session"
				width={storyImage.width}
				height={storyImage.height}
				class="h-auto w-full object-cover"
				loading="lazy"
			/>
		</div>
	</div>
</Section>
