---
import Section from '@/components/ui/Section.astro';
import { aboutTransition } from '@/data/about-mark';

const { title, paragraphs, highlights, close } = aboutTransition;
---

<Section>
	<div class="mx-auto max-w-3xl">
		<h2
			class="text-balance text-center font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
		>
			{title}
		</h2>

		<div class="mt-6 space-y-4 text-center sm:text-left">
			{
				paragraphs.map((paragraph) => (
					<p class="text-base leading-relaxed text-text">{paragraph}</p>
				))
			}
		</div>

		<ul class="mt-6 grid gap-2 sm:grid-cols-2" role="list">
			{
				highlights.map((line) => (
					<li class="flex gap-3 text-base leading-relaxed text-text">
						<span
							class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"
							aria-hidden="true"
						/>
						{line}
					</li>
				))
			}
		</ul>

		<p class="mt-8 text-center text-base font-display font-semibold leading-relaxed text-brand sm:text-left">
			{close}
		</p>
	</div>
</Section>
