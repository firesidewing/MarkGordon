---
import Button from '@/components/ui/Button.astro';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import Section from '@/components/ui/Section.astro';
import { aboutTestimonialExcerpts } from '@/data/about-mark';
---

<Section variant="muted" id="about-testimonials" class="scroll-mt-20">
	<SectionHeading title="You Don't Have To Take My Word For It." centered class="mb-10" />

	<div class="grid gap-8 lg:grid-cols-3 lg:gap-6">
		{
			aboutTestimonialExcerpts.map((testimonial) => (
				<blockquote class="relative border-t-2 border-brand bg-surface px-5 py-6 shadow-sm sm:px-6 sm:py-8">
					<svg
						class="mb-4 h-10 w-10 text-brand/20"
						viewBox="0 0 24 24"
						fill="currentColor"
						aria-hidden="true"
					>
						<path d="M7.17 6A5 5 0 0 0 2 11v7h7v-7H6.17A3.17 3.17 0 0 1 9.34 8 3.17 3.17 0 0 1 12.51 11H15.5A5.5 5.5 0 0 0 7.17 6zm10 0a5 5 0 0 0-5.17 5v7h7v-7h-2.83A3.17 3.17 0 0 1 17.17 8 3.17 3.17 0 0 1 20.34 11h2.99A5.5 5.5 0 0 0 17.17 6z" />
					</svg>
					<p class="text-base leading-relaxed text-text">&ldquo;{testimonial.quote}&rdquo;</p>
					<cite class="mt-6 block text-sm not-italic">
						<span class="font-semibold text-text-heading">{testimonial.author}</span>
						{testimonial.role && (
							<span class="mt-1 block text-xs font-semibold uppercase tracking-wide text-text-muted">
								{testimonial.role}
							</span>
						)}
					</cite>
				</blockquote>
			))
		}
	</div>

	<div class="mt-10 text-center">
		<Button href="/#testimonials" variant="secondary">
			Read More Testimonials
		</Button>
	</div>
</Section>
