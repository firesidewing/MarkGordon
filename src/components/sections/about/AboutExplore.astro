---
import SectionHeading from '@/components/sections/SectionHeading.astro';
import Section from '@/components/ui/Section.astro';
import { aboutExplore } from '@/data/about-mark';

const { title, links, testimonialsLabel, testimonialsHref } = aboutExplore;
---

<Section>
	<SectionHeading title={title} centered class="mb-8" />

	<div class="grid gap-4 sm:grid-cols-3 lg:gap-6">
		{
			links.map((link) => (
				<a
					href={link.href}
					class="group border-t-2 border-brand bg-surface px-5 py-5 shadow-sm transition-shadow hover:shadow-md sm:px-6 sm:py-6"
				>
					<h3 class="font-display text-h4 font-semibold leading-snug text-text-heading group-hover:text-brand">
						{link.title}
					</h3>
					<p class="mt-2 text-sm leading-relaxed text-text">{link.description}</p>
					<span class="mt-4 inline-block font-display text-sm font-semibold uppercase tracking-wide text-brand">
						Learn more →
					</span>
				</a>
			))
		}
	</div>

	<p class="mt-8 text-center">
		<a
			href={testimonialsHref}
			class="link-interactive font-display text-sm font-semibold uppercase tracking-wide text-brand hover:underline"
		>
			{testimonialsLabel} →
		</a>
	</p>
</Section>
