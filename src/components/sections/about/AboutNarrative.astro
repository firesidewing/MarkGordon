---
import Section from '@/components/ui/Section.astro';
import { aboutNarrative } from '@/data/about-mark';

const { title, paragraphs, close } = aboutNarrative;
---

<Section variant="muted">
	<div class="mx-auto max-w-3xl">
		<h2
			class="text-balance font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
		>
			{title}
		</h2>

		<div class="mt-6 space-y-4">
			{
				paragraphs.map((paragraph) => (
					<p class="text-base leading-relaxed text-text">{paragraph}</p>
				))
			}
		</div>

		<p class="mt-6 font-display text-base font-semibold leading-relaxed text-brand">
			{close}
		</p>
	</div>
</Section>
