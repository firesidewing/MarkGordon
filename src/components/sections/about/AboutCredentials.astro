---
import SectionHeading from '@/components/sections/SectionHeading.astro';
import Section from '@/components/ui/Section.astro';
import { aboutCredentials } from '@/data/about-mark';

const { title, stats } = aboutCredentials;
---

<Section>
	<SectionHeading title={title} centered class="mb-10" />

	<div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5 lg:gap-6">
		{
			stats.map((stat) => (
				<article class="flex flex-col items-center border-t-2 border-brand bg-surface px-3 py-6 text-center shadow-sm sm:px-4 sm:py-8">
					<p class="font-display text-2xl font-bold leading-none text-brand sm:text-3xl lg:text-4xl">
						{stat.value}
					</p>
					<p class="mt-3 text-xs font-semibold uppercase leading-snug tracking-wide text-text-heading sm:text-sm">
						{stat.label}
					</p>
				</article>
			))
		}
	</div>
</Section>
