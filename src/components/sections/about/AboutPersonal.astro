---
import { Image } from 'astro:assets';
import Section from '@/components/ui/Section.astro';
import { aboutPersonal } from '@/data/about-mark';
import portraitImage from '@/assets/content/about-mark/Mark-36-e1569198052878-750x1024.jpg';

const { title, paragraphs, lessonsIntro, lessons } = aboutPersonal;
---

<Section variant="muted">
	<div class="grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-center lg:gap-16">
		<div class="overflow-hidden">
			<Image
				src={portraitImage}
				alt="Mark Gordon"
				width={portraitImage.width}
				height={portraitImage.height}
				class="h-auto w-full object-cover"
				loading="lazy"
			/>
		</div>

		<div>
			<h2
				class="text-balance font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
			>
				{title}
			</h2>

			<div class="mt-6 space-y-4">
				{
					paragraphs.map((paragraph) => (
						<p class="text-base leading-relaxed text-text">{paragraph}</p>
					))
				}
			</div>

			<p class="mt-6 text-base leading-relaxed text-text">{lessonsIntro}</p>

			<ul class="mt-4 space-y-2" role="list">
				{
					lessons.map((lesson) => (
						<li class="flex gap-3 text-base leading-relaxed text-text-heading">
							<span
								class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"
								aria-hidden="true"
							/>
							{lesson}
						</li>
					))
				}
			</ul>
		</div>
	</div>
</Section>
