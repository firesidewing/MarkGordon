---
import { Image } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import { hubspot } from '@/config/site';
import { aboutHero } from '@/data/about-mark';
import speakingImage from '@/assets/content/keynote-speaker/Mark-32-1.jpg';

const { title, subhead, close, primaryCta, secondaryCta, secondaryHref } = aboutHero;
---

<section class="bg-surface" aria-labelledby="about-hero-heading">
	<div
		class="mx-auto w-full max-w-content px-4 py-[var(--spacing-hero-y)] pb-8 sm:px-6 sm:pb-[var(--spacing-hero-y)] lg:px-8"
	>
		<div class="grid items-center gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-12">
			<div class="max-w-[var(--width-hero-copy)] order-1">
				<h1
					id="about-hero-heading"
					class="text-balance font-display text-[length:var(--text-hero)] font-[number:var(--font-weight-hero)] leading-[var(--text-hero--line-height)] tracking-[var(--tracking-hero)] text-text-heading hero-enter"
				>
					{title}
				</h1>

				<p class="mt-4 max-w-[44ch] text-base leading-relaxed text-text hero-enter hero-enter--1">
					{subhead}
				</p>

				<p class="mt-4 max-w-[44ch] text-base leading-relaxed text-text hero-enter hero-enter--2">
					{close}
				</p>

				<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap hero-enter hero-enter--3">
					<Button href={hubspot.discoveryCall} external class="w-full sm:w-auto">
						{primaryCta}
					</Button>
					<Button href={secondaryHref} variant="secondary" class="w-full sm:w-auto">
						{secondaryCta}
					</Button>
				</div>
			</div>

			<div class="order-2 overflow-hidden lg:order-none">
				<Image
					src={speakingImage}
					alt="Mark Gordon speaking to a leadership audience"
					width={speakingImage.width}
					height={speakingImage.height}
					class="h-auto w-full object-cover"
					loading="eager"
					fetchpriority="high"
				/>
			</div>
		</div>
	</div>
</section>

<style>
	.hero-enter {
		animation: hero-rise 0.85s cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	.hero-enter--1 {
		animation-delay: 0.08s;
	}

	.hero-enter--2 {
		animation-delay: 0.16s;
	}

	.hero-enter--3 {
		animation-delay: 0.24s;
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(1rem);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-enter {
			animation: none;
		}
	}
</style>
