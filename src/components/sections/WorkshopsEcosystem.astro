---
import Section from '@/components/ui/Section.astro';
import { workshopsEcosystemSection } from '@/data/workshops';

const { title, intro, body, pathways } = workshopsEcosystemSection;
---

<Section variant="muted">
	<div class="mx-auto max-w-4xl">
		<h2
			class="text-balance text-center font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
		>
			{title}
		</h2>
		<p class="mx-auto mt-4 max-w-2xl text-center text-base leading-relaxed text-text">{intro}</p>
		<p class="mx-auto mt-4 max-w-2xl text-center text-base leading-relaxed text-text">{body}</p>

		<div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				pathways.map((item) => (
					<a
						href={item.href}
						class="group border-t-2 border-brand bg-surface px-5 py-5 shadow-sm transition-shadow hover:shadow-md sm:px-6 sm:py-6"
					>
						<h3 class="font-display text-h4 font-semibold leading-snug text-text-heading group-hover:text-brand">
							{item.title}
						</h3>
						<p class="mt-3 text-sm leading-relaxed text-text sm:text-base">{item.description}</p>
					</a>
				))
			}
		</div>
	</div>
</Section>
