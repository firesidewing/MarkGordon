---
import Section from '@/components/ui/Section.astro';
import { speakingPhilosophy } from '@/data/keynote-speaker';

const { title, lead, tensions, body, close } = speakingPhilosophy;
---

<Section class="order-3 lg:order-none">
	<div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:items-start lg:gap-16">
		<div>
			<h2
				class="text-balance font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
			>
				{title}
			</h2>
			<p class="mt-6 text-base leading-relaxed text-text">{lead}</p>
		</div>

		<div>
			<ul class="space-y-2" role="list">
				{
					tensions.map((line) => (
						<li class="flex gap-3 text-base leading-relaxed text-text">
							<span
								class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"
								aria-hidden="true"
							/>
							{line}
						</li>
					))
				}
			</ul>

			<p class="mt-6 text-base leading-relaxed text-text">{body}</p>
			<p class="mt-4 text-base leading-relaxed text-text-muted">{close}</p>
		</div>
	</div>
</Section>
