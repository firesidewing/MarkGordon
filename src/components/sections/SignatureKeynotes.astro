---
import Button from '@/components/ui/Button.astro';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import Section from '@/components/ui/Section.astro';
import { hubspot } from '@/config/site';
import { signatureKeynotes, signatureKeynotesSection, speakingHero } from '@/data/keynote-speaker';
---

<Section
	variant="muted"
	id="signature-keynotes"
	class="scroll-mt-20"
>
	<SectionHeading title={signatureKeynotesSection.title} centered class="mb-10" />

	<div class="grid gap-6 lg:grid-cols-2 lg:gap-8">
		{
			signatureKeynotes.map((keynote) => (
				<article class="border-t-2 border-brand bg-surface px-5 py-6 shadow-sm sm:px-6 sm:py-8">
					<h3 class="font-display text-h4 font-semibold leading-snug text-text-heading">
						{keynote.title}
					</h3>
					<p class="mt-4 text-sm leading-relaxed text-text sm:text-base max-sm:line-clamp-4">
						{keynote.overview}
					</p>
					<div class="mt-6">
						<p
							class="font-display text-[length:var(--text-eyebrow)] font-semibold uppercase tracking-[var(--tracking-eyebrow)] text-brand"
						>
							Audience Will Learn
						</p>
						<ul class="mt-3 space-y-2" role="list">
							{keynote.takeaways.map((takeaway) => (
								<li class="flex gap-2.5 text-sm leading-relaxed text-text sm:text-base">
									<svg
										class="mt-1.5 h-2.5 w-2.5 shrink-0 text-brand"
										viewBox="0 0 10 10"
										fill="currentColor"
										aria-hidden="true"
									>
										<circle cx="5" cy="5" r="5" />
									</svg>
									<span>{takeaway}</span>
								</li>
							))}
						</ul>
					</div>
				</article>
			))
		}
	</div>

	<div class="mt-10 text-center">
		<Button href={hubspot.discoveryCall} external>
			{speakingHero.primaryCta}
		</Button>
	</div>
</Section>
