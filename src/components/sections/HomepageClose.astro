---
import Button from "@/components/ui/Button.astro";
import NewsletterForm from "@/components/islands/NewsletterForm.svelte";
import Section from "@/components/ui/Section.astro";
import { hubspot } from "@/config/site";
import { homeFinalCta, homeNewsletter } from "@/data/home";

const { title, description, primaryCta, secondaryCta, secondaryHref } =
    homeFinalCta;
---

<div class="bg-surface-muted">
    <Section variant="muted" class="!bg-transparent !py-section-tight sm:!py-section">
        <div class="mx-auto max-w-2xl text-center">
            <h2
                class="font-display text-h2 font-h2 uppercase tracking-h2 text-brand"
            >
                {homeNewsletter.title}
            </h2>
            <p class="mt-3 text-base leading-relaxed text-text-muted">
                {homeNewsletter.description}
            </p>
            <div class="mt-8 text-left">
                <NewsletterForm client:visible />
            </div>
        </div>
    </Section>

    <section class="bg-brand py-12 text-text-inverse sm:py-16">
        <div
            class="mx-auto w-full max-w-content px-4 text-center sm:px-6 lg:px-8"
        >
            <h2
                class="text-balance font-display text-h3 font-semibold leading-snug sm:text-h2 sm:leading-tight"
            >
                {title}
            </h2>
            <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-text-inverse/90">
                {description}
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-center">
                <Button href={hubspot.discoveryCall} external class="w-full sm:w-auto">
                    {primaryCta}
                </Button>
                <Button
                    href={secondaryHref}
                    variant="secondary"
                    class="w-full !border-text-inverse !bg-transparent !text-text-inverse hover:!bg-white/10 sm:w-auto"
                >
                    {secondaryCta}
                </Button>
            </div>
        </div>
    </section>
</div>
