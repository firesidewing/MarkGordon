---
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import { hubspot } from '@/config/site';
import { speakingBookingClose } from '@/data/keynote-speaker';

const { title, body, close, primaryCta, secondaryCta } = speakingBookingClose;
---

<Section variant="brand" class="!py-12 sm:!py-16">
	<div class="mx-auto max-w-3xl text-center">
		<h2
			class="text-balance font-display text-h3 font-semibold leading-snug text-text-inverse sm:text-h2 sm:leading-tight"
		>
			{title}
		</h2>
		<p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-text-inverse/90">
			{body}
		</p>
		<p class="mt-4 text-base leading-relaxed text-text-inverse/85">{close}</p>
		<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-center">
			<Button href={hubspot.discoveryCall} external class="w-full sm:w-auto">
				{primaryCta}
			</Button>
			<Button
				href="/contact/"
				variant="secondary"
				class="w-full !border-text-inverse !bg-transparent !text-text-inverse hover:!bg-white/10 sm:w-auto"
			>
				{secondaryCta}
			</Button>
		</div>
	</div>
</Section>
