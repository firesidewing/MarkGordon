---
import type { ImageMetadata } from 'astro';
import Button from '@/components/ui/Button.astro';

interface Props {
	title: string;
	subtitle: string;
	price: string;
	bullets: string[];
	description: string;
	href: string;
	badge?: string;
	image?: ImageMetadata;
}

const { title, subtitle, price, bullets, description, href, badge, image } = Astro.props;
---

<article class="flex h-full flex-col overflow-hidden rounded-sm bg-brand text-text-inverse shadow-md">
	{
		image && (
			<div class="aspect-[16/9] overflow-hidden">
				<img src={image.src} alt={title} width={image.width} height={image.height} class="h-full w-full object-cover" loading="lazy" />
			</div>
		)
	}
	<div class="flex flex-1 flex-col p-6 sm:p-8">
		<div class="mb-3 flex items-start justify-between gap-3">
			<h3 class="font-display text-h3 font-[var(--font-weight-h3)]">{title}</h3>
			{badge && (
				<span class="shrink-0 rounded-sm bg-white/20 px-2 py-0.5 text-xs font-semibold uppercase tracking-wide">
					{badge}
				</span>
			)}
		</div>
		<p class="text-sm leading-relaxed text-text-inverse/90">{subtitle}</p>
		<p class="mt-3 font-display text-2xl font-semibold">{price}</p>
		<ul class="mt-4 flex-1 space-y-1.5 text-sm" role="list">
			{
				bullets.map((bullet) => (
					<li class="flex gap-2">
						<span aria-hidden="true">•</span>
						<span>{bullet}</span>
					</li>
				))
			}
		</ul>
		<p class="mt-4 text-sm leading-relaxed text-text-inverse/80">{description}</p>
		<div class="mt-6">
			<Button href={href} variant="text" class="!text-text-inverse hover:!underline">
				Learn More →
			</Button>
		</div>
	</div>
</article>
