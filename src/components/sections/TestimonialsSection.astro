---
import SectionHeading from '@/components/sections/SectionHeading.astro';
import Section from '@/components/ui/Section.astro';
import { homeTestimonialExcerpts } from '@/data/testimonials';
---

<Section variant="muted" id="testimonials" class="scroll-mt-20">
	<SectionHeading title="Leaders Experience the Difference." centered class="mb-10" />
	<div class="grid gap-6 lg:grid-cols-3 lg:gap-8">
		{
			homeTestimonialExcerpts.map((item) => (
				<figure class="flex h-full flex-col border-t-2 border-brand bg-surface px-6 py-8">
					<blockquote class="flex-1 text-lg font-medium italic leading-relaxed text-quote">
						<p>&ldquo;{item.quote}&rdquo;</p>
					</blockquote>
					<figcaption class="mt-6">
						<cite class="not-italic font-semibold text-text-heading">{item.author}</cite>
						{item.role && <p class="mt-1 text-sm text-text-muted">{item.role}</p>}
					</figcaption>
				</figure>
			))
		}
	</div>
</Section>
