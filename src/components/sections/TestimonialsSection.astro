---
import TestimonialsCarousel from '@/components/islands/TestimonialsCarousel.svelte';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import Section from '@/components/ui/Section.astro';
import { homeTestimonialExcerpts } from '@/data/testimonials';
---

<Section variant="muted">
	<SectionHeading title="Leaders Experience the Difference." centered class="mb-10" />
	<TestimonialsCarousel client:load testimonials={homeTestimonialExcerpts} />
	<p class="mt-8 text-center">
		<a
			href="/keynote-speaker/"
			class="link-interactive font-display text-sm font-semibold uppercase tracking-wide text-brand hover:underline"
		>
			Read more testimonials →
		</a>
	</p>
</Section>
