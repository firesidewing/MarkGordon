---
import Testimonial from '@/components/ui/Testimonial.astro';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import { homeTestimonials } from '@/data/testimonials';
---

<section class="container-site py-[var(--spacing-section)]">
	<SectionHeading title="What People Say" centered class="mb-10" />
	<div class="grid gap-8 md:grid-cols-2">
		{homeTestimonials.map((item) => <Testimonial quote={item.quote} author={item.author} role={item.role} />)}
	</div>
</section>
