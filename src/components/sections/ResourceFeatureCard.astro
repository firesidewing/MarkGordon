---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	tagline: string;
	mobileDescription: string;
	description: string;
	cta: string;
	href: string;
	image: ImageMetadata;
	imageAlt: string;
}

const { title, tagline, mobileDescription, description, cta, href, image, imageAlt } = Astro.props;
---

<a
	href={href}
	class="card-interactive group flex h-full flex-col overflow-hidden border border-surface-muted bg-surface shadow-sm"
>
	<div class="relative aspect-[16/10] overflow-hidden bg-card-header">
		<Image
			src={image}
			alt={imageAlt}
			width={image.width}
			height={image.height}
			class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02] motion-reduce:transition-none"
			loading="lazy"
		/>
	</div>
	<div class="flex flex-1 flex-col px-5 py-6 sm:px-6">
		<h3 class="font-display text-h3 font-semibold leading-snug text-text-heading group-hover:text-brand">
			{title}
		</h3>
		<p class="mt-2 text-sm font-medium leading-snug text-brand sm:text-base">{tagline}</p>
		<p class="mt-3 text-sm leading-relaxed text-text sm:hidden">{mobileDescription}</p>
		<p class="mt-3 hidden text-sm leading-relaxed text-text sm:block sm:text-base">{description}</p>
		<p
			class="mt-6 font-display text-[length:var(--text-eyebrow)] font-semibold uppercase tracking-[var(--tracking-eyebrow)] text-brand"
		>
			{cta} →
		</p>
	</div>
</a>
