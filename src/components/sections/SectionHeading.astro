---
interface Props {
	title: string;
	subtitle?: string;
	centered?: boolean;
	inverse?: boolean;
	class?: string;
}

const { title, subtitle, centered = false, inverse = false, class: className } = Astro.props;
---

<div class:list={[centered && 'text-center', className]}>
	<h2
		class:list={[
			'font-display text-h2 font-h2 uppercase tracking-h2 text-brand',
			inverse && 'text-text-inverse',
		]}
	>
		{title}
	</h2>
	{subtitle && (
		<p class:list={['mt-3 max-w-2xl text-base leading-relaxed', centered && 'mx-auto', inverse ? 'text-text-inverse/90' : 'text-text-muted']}>
			{subtitle}
		</p>
	)}
</div>
