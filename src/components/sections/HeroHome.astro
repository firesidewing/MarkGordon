---
import Button from "@/components/ui/Button.astro";
import { hubspot } from "@/config/site";
import { homeHero } from "@/data/home";

const { title, intro, experience, credibility, primaryCta, secondaryCta } =
    homeHero;
---

<section class="bg-surface" aria-labelledby="hero-heading">
    <div
        class="mx-auto w-full max-w-content px-4 py-[var(--spacing-hero-y)] sm:px-6 lg:px-8"
    >
        <div class="max-w-[var(--width-hero-copy)]">
            <h1
                id="hero-heading"
                class="text-balance font-display text-[length:var(--text-hero)] font-[number:var(--font-weight-hero)] leading-[var(--text-hero--line-height)] tracking-[var(--tracking-hero)] text-text-heading hero-enter"
            >
                {title}
            </h1>

            <p class="mt-4 max-w-[38ch] text-base leading-relaxed text-text hero-enter hero-enter--1">
                {intro}
            </p>

            <p
                class="mt-4 hidden max-w-[42ch] text-base leading-relaxed text-text-muted sm:block hero-enter hero-enter--2"
            >
                {experience}
            </p>

            <div class="mt-8 flex flex-wrap gap-3 hero-enter hero-enter--3">
                <Button href={hubspot.discoveryCall} external>
                    {primaryCta}
                </Button>
                <Button href="/keynote-speaker/" variant="secondary">
                    {secondaryCta}
                </Button>
            </div>

            <p
                class="mt-5 font-display text-[length:var(--text-eyebrow)] font-semibold uppercase tracking-[var(--tracking-eyebrow)] text-text-muted hero-enter hero-enter--4"
            >
                {credibility}
            </p>
        </div>
    </div>
</section>

<style>
    .hero-enter {
        animation: hero-rise 0.85s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .hero-enter--1 {
        animation-delay: 0.08s;
    }

    .hero-enter--2 {
        animation-delay: 0.16s;
    }

    .hero-enter--3 {
        animation-delay: 0.24s;
    }

    .hero-enter--4 {
        animation-delay: 0.32s;
    }

    @keyframes hero-rise {
        from {
            opacity: 0;
            transform: translateY(1rem);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-enter {
            animation: none;
        }
    }
</style>
