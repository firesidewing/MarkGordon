---
import Button from "@/components/ui/Button.astro";
import { hubspot } from "@/config/site";
import { homeHero } from "@/data/home";

const {
    title,
    hook,
    tensions,
    close,
    credibility,
    primaryCta,
    secondaryCta,
} = homeHero;
---

<section class="bg-surface" aria-labelledby="hero-heading">
    <div
        class="mx-auto w-full max-w-content px-4 py-[var(--spacing-hero-y)] pb-8 sm:px-6 sm:pb-[var(--spacing-hero-y)] lg:px-8"
    >
        <div class="grid items-center gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-12">
            <div class="order-1 max-w-[var(--width-hero-copy)]">
                <h1
                    id="hero-heading"
                    class="text-balance font-display text-[length:var(--text-hero)] font-[number:var(--font-weight-hero)] leading-[var(--text-hero--line-height)] tracking-[var(--tracking-hero)] text-text-heading hero-enter"
                >
                    {title}
                </h1>

                <p class="mt-4 max-w-[42ch] text-base font-medium leading-relaxed text-text-heading hero-enter hero-enter--1">
                    {hook}
                </p>

                <ul class="mt-4 max-w-[42ch] space-y-1 hero-enter hero-enter--2" role="list">
                    {
                        tensions.map((line) => (
                            <li class="text-base leading-relaxed text-text-muted">{line}</li>
                        ))
                    }
                </ul>

                <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap hero-enter hero-enter--3">
                    <Button href={hubspot.discoveryCall} external class="w-full sm:w-auto">
                        {primaryCta}
                    </Button>
                    <Button href="/keynote-speaker/" variant="secondary" class="w-full sm:w-auto">
                        {secondaryCta}
                    </Button>
                </div>

                <p class="mt-6 hidden max-w-[42ch] text-base leading-relaxed text-text sm:block hero-enter hero-enter--4">
                    {close}
                </p>

                <p
                    class="mt-5 font-display text-[length:var(--text-eyebrow)] font-semibold uppercase tracking-[var(--tracking-eyebrow)] text-text-muted hero-enter hero-enter--4"
                >
                    {credibility}
                </p>
            </div>

            <div class="order-2 overflow-hidden">
                <img
                    src="/hero-room.jpg"
                    alt="Mark Gordon facilitating a leadership session with people in the room"
                    width="640"
                    height="427"
                    class="h-56 w-full object-cover object-center sm:h-auto"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                />
            </div>
        </div>
    </div>
</section>

<style>
    .hero-enter {
        animation: hero-rise 0.85s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .hero-enter--1 {
        animation-delay: 0.08s;
    }

    .hero-enter--2 {
        animation-delay: 0.16s;
    }

    .hero-enter--3 {
        animation-delay: 0.24s;
    }

    .hero-enter--4 {
        animation-delay: 0.32s;
    }

    @keyframes hero-rise {
        from {
            opacity: 0;
            transform: translateY(1rem);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-enter {
            animation: none;
        }
    }
</style>
