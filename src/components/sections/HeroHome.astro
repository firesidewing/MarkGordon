---
import { getImage } from 'astro:assets';
import YouTube from '@/components/islands/YouTube.svelte';
import Button from '@/components/ui/Button.astro';
import { hubspot } from '@/config/site';
import { homeAssets, homeHero, homeVideoId } from '@/data/home';

const { title, intro } = homeHero;
const { videoCover } = homeAssets;
const poster = await getImage({ src: videoCover, width: 800, format: 'webp' });
---

<section class="bg-surface">
	<div class="mx-auto w-full max-w-content px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
		<div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
			<div>
				<YouTube
					videoId={homeVideoId}
					title={title}
					posterSrc={poster.src}
					posterWidth={videoCover.width}
					posterHeight={videoCover.height}
				/>
			</div>
			<div>
				<h1 class="mb-6 font-display text-h2 font-h2 uppercase tracking-h2 text-brand">{title}</h1>
				<p class="mb-6 text-base leading-relaxed text-text">{intro}</p>
				<div class="flex flex-wrap gap-3">
					<Button href={hubspot.discoveryCall} external>Book Discovery Call</Button>
					<Button href="/relationship-matters/">Buy The Book</Button>
				</div>
			</div>
		</div>
	</div>
</section>
