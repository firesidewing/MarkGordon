---
import { getImage } from 'astro:assets';
import YouTube from '@/components/islands/YouTube.svelte';
import { hubspot } from '@/config/site';
import { homeAssets, homeAudiencePaths, homeHero, homeVideoId } from '@/data/home';

const { title, intro } = homeHero;
const { videoCover } = homeAssets;
const poster = await getImage({ src: videoCover, width: 1200, format: 'webp' });
---

<section class="hero-open-door" aria-labelledby="hero-heading">
	<div class="hero-open-door__grid">
		<div class="hero-open-door__video">
			<YouTube
				client:visible
				layout="fill"
				posterPosition="18% center"
				playStyle="hero"
				videoId={homeVideoId}
				title={title}
				posterSrc={poster.src}
				posterWidth={videoCover.width}
				posterHeight={videoCover.height}
			/>
		</div>

		<div class="hero-open-door__panel">
			<div class="hero-open-door__content">
				<h1
					id="hero-heading"
					class="hero-open-door__title text-balance"
				>
					{title}
				</h1>
				<p class="hero-open-door__intro">{intro}</p>

				<ul class="hero-open-door__paths">
					{
						homeAudiencePaths.map((path) => (
							<li>
								<a
									href={path.href}
									class="hero-path-card"
									aria-label={`${path.kicker}: ${path.title}`}
								>
								<span class="hero-path-card__kicker">{path.kicker}</span>
								<span class="hero-path-card__title">{path.title}</span>
								<span class="hero-path-card__description">{path.description}</span>
								<span class="hero-path-card__cta" aria-hidden="true">
									{path.cta}
									<svg class="hero-path-card__arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true">
										<path
											d="M3 8h10M9 4l4 4-4 4"
											stroke="currentColor"
											stroke-width="1.5"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								</span>
								</a>
							</li>
						))
					}
				</ul>

				<p class="hero-open-door__secondary">
					Not sure where to start?
					<a href={hubspot.discoveryCall} target="_blank" rel="noopener noreferrer">
						Book a free discovery call
					</a>
				</p>
			</div>
		</div>
	</div>
</section>

<style>
	.hero-open-door {
		--hero-enter-ease: cubic-bezier(0.16, 1, 0.3, 1);
	}

	.hero-open-door__grid {
		display: grid;
		align-items: stretch;
	}

	@media (max-width: 1023px) {
		.hero-open-door__panel {
			order: -1;
		}
	}

	@media (min-width: 1024px) {
		.hero-open-door__grid {
			grid-template-columns: 1.12fr 0.88fr;
		}
	}

	.hero-open-door__video {
		position: relative;
		min-height: clamp(12rem, 38vw, 22rem);
		background-color: var(--color-card-dark);
	}

	.hero-open-door__video :global(> astro-island) {
		display: block;
		height: 100%;
		min-height: inherit;
	}

	@media (min-width: 1024px) {
		.hero-open-door__video {
			min-height: 0;
		}
	}

	.hero-open-door__panel {
		display: flex;
		align-items: center;
		background-color: var(--color-brand);
		padding: clamp(2rem, 5vw, 4rem) clamp(1.25rem, 4vw, 3.5rem);
	}

	.hero-open-door__content {
		width: 100%;
		max-width: 28rem;
	}

	@media (min-width: 1024px) {
		.hero-open-door__content {
			max-width: 32rem;
		}
	}

	.hero-open-door__title {
		margin-bottom: 1rem;
		font-family: var(--font-display);
		font-size: var(--text-h1);
		font-weight: var(--font-weight-h1);
		line-height: var(--text-h1--line-height);
		color: var(--color-text-inverse);
		animation: hero-enter 0.85s var(--hero-enter-ease) 0.05s both;
	}

	.hero-open-door__intro {
		margin-bottom: clamp(1.5rem, 3vw, 2rem);
		max-width: 38ch;
		font-size: 1rem;
		line-height: 1.65;
		color: color-mix(in oklab, var(--color-text-inverse) 88%, transparent);
		animation: hero-enter 0.85s var(--hero-enter-ease) 0.15s both;
	}

	.hero-open-door__paths {
		display: grid;
		gap: 0.875rem;
		margin: 0;
		padding: 0;
		list-style: none;
		animation: hero-enter 0.85s var(--hero-enter-ease) 0.28s both;
	}

	.hero-path-card {
		display: grid;
		gap: 0.25rem;
		padding: 1.125rem 1.25rem;
		border-radius: 0.125rem;
		background-color: var(--color-surface);
		color: var(--color-text-heading);
		text-decoration: none;
		box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.06);
		transition:
			transform 0.35s var(--hero-enter-ease),
			box-shadow 0.35s var(--hero-enter-ease);
	}

	.hero-path-card:hover {
		transform: translateY(-2px);
		box-shadow:
			0 12px 24px -8px rgb(0 0 0 / 0.18),
			0 4px 8px -4px rgb(0 0 0 / 0.08);
	}

	.hero-path-card:focus-visible {
		outline: 2px solid var(--color-text-inverse);
		outline-offset: 3px;
	}

	.hero-path-card__kicker {
		font-family: var(--font-display);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-brand);
	}

	.hero-path-card__title {
		font-family: var(--font-display);
		font-size: 1.125rem;
		font-weight: 600;
		line-height: 1.3;
	}

	.hero-path-card__description {
		font-size: 0.8125rem;
		line-height: 1.55;
		color: var(--color-text-muted);
	}

	.hero-path-card__cta {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		margin-top: 0.375rem;
		font-family: var(--font-display);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-brand);
	}

	.hero-path-card__arrow {
		width: 0.875rem;
		height: 0.875rem;
		transition: transform 0.35s var(--hero-enter-ease);
	}

	.hero-path-card:hover .hero-path-card__arrow {
		transform: translateX(3px);
	}

	.hero-open-door__secondary {
		margin-top: 1.5rem;
		font-size: 0.8125rem;
		line-height: 1.5;
		color: color-mix(in oklab, var(--color-text-inverse) 75%, transparent);
		animation: hero-enter 0.85s var(--hero-enter-ease) 0.4s both;
	}

	.hero-open-door__secondary a {
		color: var(--color-text-inverse);
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.hero-open-door__secondary a:hover {
		text-decoration-thickness: 2px;
	}

	@keyframes hero-enter {
		from {
			opacity: 0;
			transform: translateY(1.125rem);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-open-door__title,
		.hero-open-door__intro,
		.hero-open-door__paths,
		.hero-open-door__secondary {
			animation: none;
		}

		.hero-path-card {
			transition: none;
		}

		.hero-path-card:hover {
			transform: none;
		}

		.hero-path-card__arrow {
			transition: none;
		}
	}
</style>
