---
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import { hubspot } from '@/config/site';
import { speakingHero, whatMakesMarkDifferent } from '@/data/keynote-speaker';

const { title, lead, emphasis, credentials, close, testimonial } = whatMakesMarkDifferent;
---

<Section>
	<div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:items-start lg:gap-16">
		<div>
			<h2
				class="text-balance font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
			>
				{title}
			</h2>
			<p class="mt-6 text-base leading-relaxed text-text">{lead}</p>
			<p class="mt-2 font-display text-lg font-semibold leading-snug text-brand">{emphasis}</p>
			<p class="mt-6 font-display text-sm font-semibold uppercase tracking-wide text-brand">
				His leadership journey includes:
			</p>
		</div>

		<div>
			<ul class="space-y-2" role="list">
				{
					credentials.map((item) => (
						<li class="flex gap-3 text-base leading-relaxed text-text">
							<span
								class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"
								aria-hidden="true"
							/>
							{item}
						</li>
					))
				}
			</ul>

			<p class="mt-6 text-base leading-relaxed text-text">{close}</p>
			<p class="mt-4 text-base leading-relaxed text-text-muted italic">{testimonial}</p>

			<div class="mt-8">
				<Button href={hubspot.discoveryCall} external>
					{speakingHero.primaryCta}
				</Button>
			</div>
		</div>
	</div>
</Section>
