---
import Button from '@/components/ui/Button.astro';
import { hubspot } from '@/config/site';
import { homeQuote, homeResults } from '@/data/home';
---

<section class="mx-auto w-full max-w-content px-4 py-section sm:px-6 lg:px-8" aria-labelledby="approach-heading">
	<h2 id="approach-heading" class="sr-only">Mark's approach to relationship coaching</h2>

	<blockquote class="mx-auto mb-12 max-w-3xl text-center">
		<p class="text-xl font-medium italic leading-relaxed text-text-heading sm:text-2xl text-balance">
			&ldquo;{homeQuote.text}&rdquo;
		</p>
	</blockquote>

	<div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
		<div>
			<p class="leading-relaxed text-text">{homeQuote.body}</p>
			<p class="mt-4 font-display text-lg font-semibold text-brand">{homeQuote.emphasis}</p>
			<p class="mt-4 leading-relaxed text-text">{homeQuote.mission}</p>
		</div>
		<div>
			<h3 class="mb-4 font-display text-h4 font-semibold uppercase tracking-wide text-text-heading">
				The results are&hellip;
			</h3>
			<ul class="space-y-3" role="list">
				{
					homeResults.map((item) => (
						<li class="flex gap-3 text-sm leading-relaxed text-text">
							<span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-brand" aria-hidden="true" />
							{item}
						</li>
					))
				}
			</ul>
			<div class="mt-8">
				<Button href={hubspot.discoveryCall} external>Book Discovery Call</Button>
			</div>
		</div>
	</div>
</section>
