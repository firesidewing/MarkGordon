---
import Section from '@/components/ui/Section.astro';
import { acceleratorElements } from '@/data/leadership-accelerator';

const { title, items } = acceleratorElements;
---

<Section variant="brand">
	<h2
		class="text-balance text-center font-display text-h3 font-semibold leading-snug text-text-inverse sm:text-h2 sm:leading-tight"
	>
		{title}
	</h2>

	<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:gap-8">
		{
			items.map((item) => (
				<article class="border-t-2 border-text-inverse/30 bg-white/5 px-5 py-6 sm:px-6 sm:py-8">
					<p
						class="font-display text-sm font-semibold uppercase tracking-wide text-text-inverse/70"
						aria-hidden="true"
					>
						{item.number}
					</p>
					<h3 class="mt-2 font-display text-h4 font-semibold leading-snug text-text-inverse">
						{item.title}
					</h3>
					<p class="mt-1 font-display text-base font-semibold text-text-inverse/90">
						{item.subtitle}
					</p>
					<p class="mt-4 text-sm leading-relaxed text-text-inverse/85 sm:text-base">
						{item.body}
					</p>
				</article>
			))
		}
	</div>
</Section>
