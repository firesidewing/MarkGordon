---
import { homeBlindSpot } from "@/data/home";

interface Props {
    title?: string;
    subtitle?: string;
    description?: string;
    ctaLabel?: string;
    href?: string;
    class?: string;
}

const {
    title = homeBlindSpot.title,
    subtitle = homeBlindSpot.subtitle,
    description,
    ctaLabel = homeBlindSpot.cta,
    href = homeBlindSpot.href,
    class: className,
} = Astro.props;
---

<section class:list={["bg-brand py-8 text-text-inverse sm:py-10", className]}>
    <div
        class="mx-auto flex w-full max-w-content flex-col items-center justify-between gap-6 px-4 sm:flex-row sm:items-center sm:px-6 lg:px-8"
    >
        <div class="text-center sm:text-left">
            <p class="font-display text-lg font-semibold sm:text-xl">
                {title}
            </p>
            <p class="mt-1 text-sm text-text-inverse/90">
                {subtitle}
            </p>
            {
                description && (
                    <p class="mt-2 max-w-xl text-sm leading-relaxed text-text-inverse/85">
                        {description}
                    </p>
                )
            }
        </div>
        <a
            href={href}
            class="link-interactive inline-flex min-h-11 w-full shrink-0 items-center justify-center whitespace-nowrap font-display text-button font-button text-text-inverse underline-offset-4 hover:underline sm:w-auto sm:justify-start"
        >
            {ctaLabel} →
        </a>
    </div>
</section>
