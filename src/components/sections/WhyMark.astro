---
import { Image } from "astro:assets";
import Button from "@/components/ui/Button.astro";
import Section from "@/components/ui/Section.astro";
import { homeWhyMark } from "@/data/home";

const { title, paragraphs, emphasis, cta, href, image } = homeWhyMark;
---

<Section>
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-14">
        <div>
            <h2
                class="text-balance font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
            >
                {title}
            </h2>
            <p class="mt-6 font-display text-lg font-semibold leading-snug text-brand">
                {emphasis}
            </p>
            <div class="mt-6 space-y-4">
                {
                    paragraphs.map((paragraph) => (
                        <p class="text-base leading-relaxed text-text">{paragraph}</p>
                    ))
                }
            </div>
            <div class="mt-8">
                <Button href={href}>{cta}</Button>
            </div>
        </div>

        <div class="overflow-hidden">
            <Image
                src={image}
                alt="Mark Gordon speaking with an audience"
                width={image.width}
                height={image.height}
                class="h-auto w-full object-cover"
                loading="lazy"
            />
        </div>
    </div>
</Section>
