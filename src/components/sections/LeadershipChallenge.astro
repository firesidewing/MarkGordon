---
import Button from "@/components/ui/Button.astro";
import Section from "@/components/ui/Section.astro";
import { hubspot } from "@/config/site";
import { homeChallenge } from "@/data/home";

const { title, body, payoff, cta, quote, quoteAuthor, quoteRole } = homeChallenge;
---

<Section variant="muted" class="py-section-tight sm:py-section">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
        <div>
            <h2
                class="text-balance font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
            >
                {title}
            </h2>
            <p class="mt-6 text-base leading-relaxed text-text">{body}</p>
            <p class="mt-4 text-base leading-relaxed text-text">{payoff}</p>
            <div class="mt-8">
                <Button href={hubspot.discoveryCall} external>
                    {cta}
                </Button>
            </div>
        </div>

        <blockquote class="border-l-2 border-brand pl-5">
            <p class="text-lg font-medium italic leading-relaxed text-text-heading">
                &ldquo;{quote}&rdquo;
            </p>
            <footer class="mt-4 text-sm text-text-muted">
                <cite class="not-italic font-semibold text-text-heading">{quoteAuthor}</cite>
                <span class="block">{quoteRole}</span>
            </footer>
        </blockquote>
    </div>
</Section>
