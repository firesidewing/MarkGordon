---
import { Image } from "astro:assets";
import Button from "@/components/ui/Button.astro";
import Section from "@/components/ui/Section.astro";
import { hubspot } from "@/config/site";
import { homeChallenge } from "@/data/home";

const { title, body, payoff, cta, image } = homeChallenge;
---

<Section variant="muted">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
        <div>
            <h2
                class="text-balance font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
            >
                {title}
            </h2>
            <p class="mt-6 text-base leading-relaxed text-text">{body}</p>
            <p class="mt-4 text-base leading-relaxed text-text">{payoff}</p>
            <div class="mt-8">
                <Button href={hubspot.discoveryCall} external>
                    {cta}
                </Button>
            </div>
        </div>

        <div class="editorial-frame">
            <Image
                src={image}
                alt="Mark Gordon speaking with a leadership audience"
                width={image.width}
                height={image.height}
                class="editorial-photo object-center"
                loading="lazy"
            />
        </div>
    </div>
</Section>
