---
import Section from '@/components/ui/Section.astro';
import { acceleratorTransformation } from '@/data/leadership-accelerator';

const { title, stages, intro, shifts } = acceleratorTransformation;
---

<Section>
	<div class="mx-auto max-w-4xl">
		<h2
			class="text-balance text-center font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
		>
			{title}
		</h2>

		<div class="mt-10" aria-label="Leadership development journey">
			<ol class="flex flex-wrap items-center justify-center gap-2 sm:gap-3" role="list">
				{
					stages.map((stage) => (
						<li
							class="rounded-full bg-brand px-4 py-2 font-display text-xs font-semibold uppercase tracking-wide text-text-inverse sm:text-sm"
						>
							{stage}
						</li>
					))
				}
			</ol>
			<p class="mt-3 text-center text-sm text-text-muted sm:hidden" aria-hidden="true">
				{stages.join(' → ')}
			</p>
		</div>

		<p class="mx-auto mt-8 max-w-2xl text-center text-base leading-relaxed text-text">
			{intro}
		</p>

		<div class="mt-10 grid gap-4 sm:grid-cols-2">
			{
				shifts.map((shift, index) => (
					<div
						class="flex gap-4 border-l-4 border-brand bg-surface-muted px-5 py-4 sm:px-6 sm:py-5"
					>
						<span
							class="font-display text-sm font-semibold text-brand"
							aria-hidden="true"
						>
							{index + 1}
						</span>
						<p class="text-base leading-relaxed text-text-heading italic">{shift}</p>
					</div>
				))
			}
		</div>
	</div>
</Section>
