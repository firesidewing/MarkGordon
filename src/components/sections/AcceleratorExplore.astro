---
import Section from '@/components/ui/Section.astro';
import { acceleratorExplore } from '@/data/leadership-accelerator';

const { title, intro, topics } = acceleratorExplore;
---

<Section variant="muted">
	<div class="mx-auto max-w-4xl text-center">
		<h2
			class="text-balance font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
		>
			{title}
		</h2>
		<p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-text">{intro}</p>
	</div>

	<div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
		{
			topics.map((topic) => (
				<article class="bg-surface px-5 py-5 shadow-sm sm:px-6 sm:py-6">
					<h3 class="font-display text-h4 font-semibold leading-snug text-brand">
						{topic.title}
					</h3>
					<p class="mt-3 text-sm leading-relaxed text-text sm:text-base">
						{topic.description}
					</p>
				</article>
			))
		}
	</div>
</Section>
