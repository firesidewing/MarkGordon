---
import Section from '@/components/ui/Section.astro';
import { acceleratorProblem } from '@/data/leadership-accelerator';

const { title, paragraphs, needs, close } = acceleratorProblem;
---

<Section variant="muted">
	<div class="mx-auto max-w-3xl">
		<h2
			class="text-balance text-center font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
		>
			{title}
		</h2>

		<div class="mt-8 space-y-4 text-center">
			{
				paragraphs.map((line) => (
					<p class="text-base leading-relaxed text-text">{line}</p>
				))
			}
		</div>

		<ul class="mt-8 space-y-3" role="list">
			{
				needs.map((line) => (
					<li class="flex gap-3 text-base leading-relaxed text-text">
						<span
							class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"
							aria-hidden="true"
						/>
						{line}
					</li>
				))
			}
		</ul>

		<p class="mt-8 text-center text-base font-semibold leading-relaxed text-text-heading">
			{close}
		</p>
	</div>
</Section>
