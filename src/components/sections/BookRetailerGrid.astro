---
import type { BookRetailer } from "@/data/relationship-matters";

interface Props {
    retailers: BookRetailer[][];
}

const { retailers } = Astro.props;
---

<section class="bg-brand">
    <div class="mx-auto w-full max-w-content divide-y divide-white/90">
        {
            retailers.map((row) => (
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
                    {row.map((retailer, colIndex) => (
                        <div
                            class:list={[
                                "flex min-h-24 flex-col items-center justify-center px-4 py-8 text-center sm:min-h-28 sm:px-6 sm:py-10 lg:min-h-32 lg:py-12",
                                colIndex < row.length - 1 &&
                                    "border-b border-white/90 sm:border-b-0",
                                colIndex === 0 &&
                                    "sm:border-r sm:border-white/90",
                                colIndex === 1 &&
                                    "lg:border-r lg:border-white/90",
                                colIndex === 2 &&
                                    row.length === 3 &&
                                    "sm:col-span-2 sm:border-t sm:border-white/90 lg:col-span-1 lg:border-t-0",
                            ]}
                        >
                            <a
                                href={retailer.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="font-display text-xl font-semibold uppercase leading-snug text-text-inverse transition-opacity hover:opacity-90 lg:text-2xl xl:text-[1.875rem]"
                            >
                                {retailer.lines.map((line, lineIndex) => (
                                    <>
                                        {line}
                                        {lineIndex < retailer.lines.length - 1 && (
                                            <br />
                                        )}
                                    </>
                                ))}
                            </a>
                        </div>
                    ))}
                </div>
            ))
        }
    </div>
</section>
