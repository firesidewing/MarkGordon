---
import { Image } from "astro:assets";
import Button from "@/components/ui/Button.astro";
import Section from "@/components/ui/Section.astro";
import { homeGoDeeper } from "@/data/home";

const { coaching, relationshipMatters } = homeGoDeeper;
---

<Section>
    <div class="grid gap-6 lg:grid-cols-2 lg:gap-8">
        <article class="flex flex-col justify-center border-t-2 border-brand bg-surface-muted px-6 py-8 sm:px-8">
            <h2 class="font-display text-h3 font-semibold leading-snug text-text-heading">
                {coaching.title}
            </h2>
            <p class="mt-2 font-display text-lg font-semibold text-brand">
                {coaching.subtitle}
            </p>
            <p class="mt-4 text-base leading-relaxed text-text">
                {coaching.description}
            </p>
            <div class="mt-8">
                <Button href={coaching.href}>{coaching.cta}</Button>
            </div>
        </article>

        <article class="grid overflow-hidden bg-surface shadow-sm lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
            <div class="flex items-center justify-center bg-brand p-6">
                <Image
                    src={relationshipMatters.image}
                    alt="Relationship Matters book cover"
                    width={relationshipMatters.image.width}
                    height={relationshipMatters.image.height}
                    class="h-auto max-h-56 w-full max-w-[12rem] object-contain"
                    loading="lazy"
                />
            </div>
            <div class="flex flex-col justify-center px-6 py-8 sm:px-8">
                <h2 class="font-display text-h3 font-semibold leading-snug text-text-heading">
                    {relationshipMatters.title}
                </h2>
                <p class="mt-2 font-display text-lg font-semibold text-brand">
                    {relationshipMatters.subtitle}
                </p>
                <p class="mt-4 text-base leading-relaxed text-text">
                    {relationshipMatters.description}
                </p>
                <p
                    class="mt-4 text-balance font-display text-xs font-semibold tracking-wide text-text-heading sm:text-sm"
                >
                    {
                        relationshipMatters.pillars.join(" · ")
                    }
                </p>
                <div class="mt-8">
                    <Button href={relationshipMatters.href}>
                        {relationshipMatters.cta}
                    </Button>
                </div>
            </div>
        </article>
    </div>
</Section>
