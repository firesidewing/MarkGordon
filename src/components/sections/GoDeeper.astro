---
import { Image } from "astro:assets";
import Button from "@/components/ui/Button.astro";
import Section from "@/components/ui/Section.astro";
import { homeGoDeeper } from "@/data/home";

const { relationshipMatters } = homeGoDeeper;
---

<Section>
    <article class="grid items-center gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-12">
        <div class="flex items-center justify-center bg-brand p-8">
            <Image
                src={relationshipMatters.image}
                alt="Relationship Matters book cover"
                width={relationshipMatters.image.width}
                height={relationshipMatters.image.height}
                class="h-auto max-h-56 w-full max-w-[12rem] object-contain"
                loading="lazy"
            />
        </div>
        <div>
            <h2 class="font-display text-h3 font-semibold leading-snug text-text-heading">
                {relationshipMatters.title}
            </h2>
            <p class="mt-2 font-display text-lg font-semibold text-brand">
                {relationshipMatters.subtitle}
            </p>
            <p class="mt-4 text-base leading-relaxed text-text">
                {relationshipMatters.description}
            </p>
            <p class="mt-4 text-balance font-display text-xs font-semibold tracking-wide text-text-heading sm:text-sm">
                {relationshipMatters.pillars.join(" · ")}
            </p>
            <div class="mt-8">
                <Button href={relationshipMatters.href}>
                    {relationshipMatters.cta}
                </Button>
            </div>
        </div>
    </article>
</Section>
