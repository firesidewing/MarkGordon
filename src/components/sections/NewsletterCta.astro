---
import { Image } from 'astro:assets';
import NewsletterForm from '@/components/islands/NewsletterForm.svelte';
import { homeAssets } from '@/data/home';

const { podcastImg } = homeAssets;
---

<section class="bg-surface-muted">
	<div class="mx-auto w-full max-w-content px-4 py-section sm:px-6 lg:px-8">
		<div class="grid items-start gap-8 lg:grid-cols-2 lg:gap-12">
			<div>
				<h2 class="mb-3 font-display text-h2 font-h2 uppercase tracking-h2 text-brand">Subscribe to My Newsletter</h2>
				<p class="mb-6 leading-relaxed text-text-muted">
					We send out weekly newsletters with relationship tips, news on upcoming events and the latest courses.
				</p>
				<NewsletterForm client:visible />
			</div>
			<a
				href="https://open.spotify.com/show/24p7utX5IUjVIAz3RrCiPh"
				target="_blank"
				rel="noopener noreferrer"
				class="block overflow-hidden rounded-sm shadow-md transition-shadow hover:shadow-lg"
			>
				<Image
					src={podcastImg}
					alt="Mark Gordon podcast on Spotify"
					width={podcastImg.width}
					height={podcastImg.height}
					class="h-auto w-full"
					loading="lazy"
				/>
			</a>
		</div>
	</div>
</section>
