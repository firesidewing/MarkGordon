---
import Section from '@/components/ui/Section.astro';
import { contactNotSure } from '@/data/contact';

const { title, body, hint, close } = contactNotSure;
---

<Section variant="muted" class="!py-12 sm:!py-16">
	<div class="mx-auto max-w-2xl text-center">
		<h2 class="font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2">
			{title}
		</h2>
		<p class="mt-3 text-base leading-relaxed text-text">{body}</p>
		<p class="mt-4 text-base italic leading-relaxed text-text-heading">{hint}</p>
		<p class="mt-4 text-base leading-relaxed text-text-muted">{close}</p>
		<p class="mt-6">
			<a
				href="#contact-form"
				class="link-interactive font-display text-sm font-semibold uppercase tracking-wide text-brand hover:underline"
			>
				Start the Conversation →
			</a>
		</p>
	</div>
</Section>
