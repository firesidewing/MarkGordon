---
import SectionHeading from '@/components/sections/SectionHeading.astro';
import Section from '@/components/ui/Section.astro';
import { contactHelp } from '@/data/contact';

const { title, items } = contactHelp;
---

<Section variant="muted">
	<SectionHeading title={title} centered class="mb-8" />

	<div class="grid gap-6 md:grid-cols-2">
		{
			items.map((item) => (
				<article class="border-t-2 border-brand bg-surface px-5 py-6 shadow-sm sm:px-6">
					<h3 class="font-display text-h4 font-semibold leading-snug text-text-heading">
						{item.title}
					</h3>
					<p class="mt-3 text-sm leading-relaxed text-text">{item.body}</p>
					<ul class="mt-5 flex flex-col gap-2">
						{item.links.map((link) => (
							<li>
								<a
									href={link.href}
									class="link-interactive font-display text-sm font-semibold uppercase tracking-wide text-brand hover:underline"
								>
									{link.label} →
								</a>
							</li>
						))}
					</ul>
				</article>
			))
		}
	</div>
</Section>
