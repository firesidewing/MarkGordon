---
import Section from '@/components/ui/Section.astro';
import { contactProcess } from '@/data/contact';

const { title, steps, close } = contactProcess;
---

<Section>
	<div class="mx-auto max-w-3xl">
		<h2
			class="text-center text-balance font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
		>
			{title}
		</h2>
		<ol class="mt-10 space-y-8">
			{
				steps.map((step, index) => (
					<li class="flex gap-5">
						<span
							class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand font-display text-sm font-bold text-text-inverse"
							aria-hidden="true"
						>
							{index + 1}
						</span>
						<div>
							<h3 class="font-display text-h4 font-semibold uppercase tracking-wide text-brand">
								{step.title}
							</h3>
							<p class="mt-2 text-base leading-relaxed text-text">{step.body}</p>
						</div>
					</li>
				))
			}
		</ol>
		<p class="mt-10 text-center text-base font-medium leading-relaxed text-text-heading">{close}</p>
	</div>
</Section>
