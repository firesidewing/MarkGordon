---
import Section from '@/components/ui/Section.astro';
import {
	additionalWorkshopTopics,
	additionalWorkshopTopicsSection,
} from '@/data/workshops';
---

<Section>
	<div class="mx-auto max-w-4xl">
		<h2
			class="text-balance text-center font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
		>
			{additionalWorkshopTopicsSection.title}
		</h2>
		<p class="mx-auto mt-4 max-w-2xl text-center text-base leading-relaxed text-text">
			{additionalWorkshopTopicsSection.intro}
		</p>

		<div class="mt-10 grid gap-4 sm:grid-cols-2 lg:gap-6">
			{
				additionalWorkshopTopics.map((topic) => (
					<article class="border-t-2 border-brand bg-surface px-5 py-5 shadow-sm sm:px-6 sm:py-6">
						<h3 class="font-display text-h4 font-semibold leading-snug text-text-heading">
							{topic.title}
						</h3>
						<p class="mt-3 text-sm leading-relaxed text-text sm:text-base">{topic.description}</p>
					</article>
				))
			}
		</div>
	</div>
</Section>
