---
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import { acceleratorFinalCta } from '@/data/leadership-accelerator';

const { title, lines, body, cta, href } = acceleratorFinalCta;
---

<Section>
	<div class="mx-auto max-w-3xl text-center">
		<h2
			class="text-balance font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
		>
			{title}
		</h2>

		<div class="mt-6 space-y-2">
			{
				lines.map((line) => (
					<p class="text-base leading-relaxed text-text">{line}</p>
				))
			}
		</div>

		<p class="mt-6 text-base leading-relaxed text-text">{body}</p>

		<div class="mt-8">
			<Button href={href} external>{cta}</Button>
		</div>
	</div>
</Section>
