---
import Section from '@/components/ui/Section.astro';
import { workshopsFrameworkSection } from '@/data/workshops';

const { title, intro, steps, close } = workshopsFrameworkSection;
---

<Section>
	<div class="mx-auto max-w-4xl">
		<div class="mx-auto max-w-3xl text-center">
			<h2
				class="text-balance font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
			>
				{title}
			</h2>
			<p class="mt-4 text-base leading-relaxed text-text">{intro}</p>
		</div>

		<ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5 lg:gap-3" role="list">
			{
				steps.map((step, index) => (
					<li class="border-t-2 border-brand bg-surface-muted px-4 py-5 text-center sm:px-5">
						<p
							class="font-display text-[length:var(--text-eyebrow)] font-semibold uppercase tracking-[var(--tracking-eyebrow)] text-brand"
						>
							{step.label}
						</p>
						<p class="mt-3 text-sm leading-relaxed text-text sm:text-base">{step.description}</p>
						{index < steps.length - 1 && (
							<span
								class="mt-3 hidden font-display text-brand lg:block"
								aria-hidden="true"
							>
								→
							</span>
						)}
					</li>
				))
			}
		</ol>

		<p class="mx-auto mt-10 max-w-2xl text-center font-display text-base font-semibold leading-relaxed text-text-heading sm:text-lg">
			{close}
		</p>
	</div>
</Section>
