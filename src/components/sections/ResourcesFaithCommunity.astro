---
import { Image } from 'astro:assets';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import faithImage from '@/assets/content/faith-community-packages/Mark-32-1-1024x1024.jpg';
import { faithCommunitySection } from '@/data/resources';

const { title, subtitle, intro, topics, cta, href } = faithCommunitySection;
---

<Section id="faith-community">
	<div class="grid items-center gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-14">
		<div class="overflow-hidden">
			<Image
				src={faithImage}
				alt="Mark Gordon speaking with faith community leaders"
				width={faithImage.width}
				height={faithImage.height}
				class="aspect-square w-full max-w-md object-cover"
				loading="lazy"
			/>
		</div>
		<div>
			<SectionHeading title={title} subtitle={subtitle} class="mb-4" />
			<p class="text-base leading-relaxed text-text-muted">{intro}</p>
			<p class="mt-4 font-display text-sm font-semibold uppercase tracking-wide text-text-heading">
				Explore resources related to:
			</p>
			<ul class="mt-3 grid gap-2 sm:grid-cols-2">
				{topics.map((topic) => (
					<li class="flex items-start gap-2 text-sm text-text sm:text-base">
						<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true" />
						{topic}
					</li>
				))}
			</ul>
			<div class="mt-8">
				<Button href={href}>{cta}</Button>
			</div>
		</div>
	</div>
</Section>
