---
interface Props {
    href: string;
    variant?: "primary" | "secondary" | "text";
    external?: boolean;
    class?: string;
}

const {
    href,
    variant = "primary",
    external = false,
    class: className,
} = Astro.props;

const variantClasses = {
    primary:
        "btn-interactive inline-flex min-h-11 items-center justify-center rounded-button bg-brand px-8 py-3 font-display text-button font-button uppercase text-text-inverse hover:bg-brand-dark",
    secondary:
        "btn-interactive inline-flex min-h-11 items-center justify-center rounded-button border-2 border-brand bg-surface px-8 py-3 font-display text-button font-button uppercase text-brand hover:bg-surface-muted",
    text: "link-interactive inline-flex min-h-11 items-center font-display text-button font-button uppercase text-text-inverse underline-offset-4 hover:underline",
};

const classes = [variantClasses[variant], className];
---

<a
    href={href}
    class:list={classes}
    {...external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
>
    <slot />
</a>
