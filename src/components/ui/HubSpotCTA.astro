---
import Button from '@/components/ui/Button.astro';
import { hubspot } from '@/config/site';

interface Props {
	label?: string;
	class?: string;
}

const { label = 'Book Discovery Call', class: className } = Astro.props;
---

<div class:list={['rounded-sm bg-surface-muted p-6 text-center', className]}>
	<p class="mb-4 text-sm leading-relaxed text-text-muted">
		Ready to strengthen your relationships? Schedule a free discovery call.
	</p>
	<Button href={hubspot.discoveryCall} external>
		{label}
	</Button>
</div>
