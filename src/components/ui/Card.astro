---
import { Image } from 'astro:assets';
import { formatDate, postUrl } from '@/utils/content';

interface Props {
	title: string;
	href?: string;
	slug?: string;
	date?: Date;
	excerpt?: string;
	image?: string;
	imageAlt?: string;
	class?: string;
}

const {
	title,
	href,
	slug,
	date,
	excerpt,
	image,
	imageAlt = '',
	class: className,
} = Astro.props;

const link = href ?? (slug ? postUrl(slug) : undefined);
---

<article
	class:list={[
		'flex h-full flex-col overflow-hidden rounded-sm border border-surface-muted bg-surface shadow-sm transition-shadow hover:shadow-md',
		className,
	]}
>
	{
		image && (
			<div class="aspect-[16/10] overflow-hidden bg-surface-alt">
				<Image src={image} alt={imageAlt || title} inferSize class="h-full w-full object-cover" loading="lazy" />
			</div>
		)
	}
	<div class="flex flex-1 flex-col p-6">
		{
			date && (
				<time datetime={date.toISOString()} class="mb-2 text-xs uppercase tracking-wide text-text-subtle">
					{formatDate(date)}
				</time>
			)
		}
		<h3 class="font-display text-h4 font-h3 text-text-heading">
			{
				link ? (
					<a href={link} class="transition-colors hover:text-brand">
						{title}
					</a>
				) : (
					title
				)
			}
		</h3>
		{excerpt && <p class="mt-3 flex-1 text-sm leading-relaxed text-text-muted">{excerpt}</p>}
		{
			link && (
				<a href={link} class="mt-4 text-sm font-semibold uppercase tracking-wide text-brand hover:underline">
					Read more →
				</a>
			)
		}
		<slot />
	</div>
</article>
