---
import HubSpotCTA from '@/components/ui/HubSpotCTA.astro';
import { categoryUrl } from '@/utils/content';
import type { CollectionEntry } from 'astro:content';

interface Props {
	categories: { name: string; count: number }[];
	activeCategory?: string;
	recentPosts?: CollectionEntry<'blog'>[];
}

const { categories, activeCategory, recentPosts } = Astro.props;
---

<aside class="space-y-8">
	<div class="border-l-4 border-brand pl-5">
		<h2 class="mb-4 font-display text-h5 font-semibold uppercase tracking-wide text-text-heading">
			Browse Mark&rsquo;s Blog
		</h2>
		{
			categories.length > 0 ? (
				<ul class="divide-y divide-surface-muted" role="list">
					{
						categories.map(({ name, count }) => (
							<li>
								<a
									href={categoryUrl(name)}
									class:list={[
										'flex items-center justify-between py-2.5 text-sm transition-colors hover:text-brand',
										activeCategory === name ? 'font-semibold text-brand' : 'text-text-muted',
									]}
								>
									<span>{name}</span>
									<span class="text-xs text-text-subtle">{count}</span>
								</a>
							</li>
						))
					}
				</ul>
			) : (
				<p class="text-sm text-text-muted">No categories yet.</p>
			)
		}
	</div>

	{
		recentPosts && recentPosts.length > 0 && (
			<div>
				<h3 class="mb-3 font-display text-sm font-semibold uppercase tracking-wide text-text-heading">
					Recent Posts
				</h3>
				<ul class="space-y-3" role="list">
					{
						recentPosts.map((post) => (
							<li>
								<a
									href={`/${post.data.slug}/`}
									class="text-sm leading-snug text-text-muted transition-colors hover:text-brand"
								>
									{post.data.title}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		)
	}

	<HubSpotCTA />
</aside>
