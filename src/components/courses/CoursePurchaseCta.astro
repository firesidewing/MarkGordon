---
import Button from '@/components/ui/Button.astro';
import { formatPrice } from '@/lib/courses';

interface Props {
	title: string;
	price: number;
	class?: string;
}

const { title, price, class: className } = Astro.props;
---

<div class:list={['rounded-sm border border-surface-muted bg-surface-muted/50 p-6', className]}>
	<p class="font-display text-lg font-semibold text-text-heading">{title}</p>
	<p class="mt-2 text-sm text-text-muted">365 days of access · watch on your schedule</p>
	<p class="mt-4 font-display text-2xl font-semibold text-text-heading">{formatPrice(price)}</p>
	<div class="mt-6">
		<Button href="/registration/">Buy now — coming soon</Button>
	</div>
	<p class="mt-3 text-xs text-text-muted">Secure checkout and account access are launching shortly.</p>
</div>
