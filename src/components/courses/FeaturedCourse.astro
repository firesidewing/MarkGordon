---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from '@/components/ui/Button.astro';
import type { CollectionEntry } from 'astro:content';
import { courseHref, formatPrice } from '@/lib/courses';

interface Props {
	course: CollectionEntry<'courses'>;
	cover?: ImageMetadata;
}

const { course, cover } = Astro.props;
const { title, subtitle, hook, description, bullets, price, badge } = course.data;
const summary = hook ?? description;
---

<article class="grid gap-8 overflow-hidden border border-surface-muted bg-surface shadow-sm lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-0">
	<div class="flex flex-col justify-center px-6 py-8 sm:px-10 sm:py-10 lg:px-12">
		{
			badge && (
				<p class="mb-3 font-display text-xs font-semibold uppercase tracking-widest text-brand">{badge}</p>
			)
		}
		<h2 class="font-display text-3xl font-h2 uppercase tracking-h2 text-text-heading sm:text-4xl">{title}</h2>
		<p class="mt-3 text-base font-medium text-text-heading">{subtitle}</p>
		<p class="mt-4 max-w-prose text-sm leading-relaxed text-text-muted">{summary}</p>

		<ul class="mt-6 space-y-2.5 text-sm text-text" role="list">
			{
				bullets.map((bullet) => (
					<li class="flex gap-3">
						<span class="mt-0.5 text-brand" aria-hidden="true">✓</span>
						<span>
							{bullet.highlight ? (
								<>
									{bullet.text.slice(0, bullet.text.toLowerCase().indexOf(bullet.highlight.toLowerCase()))}
									<strong>{bullet.highlight}</strong>
									{bullet.text.slice(
										bullet.text.toLowerCase().indexOf(bullet.highlight.toLowerCase()) + bullet.highlight.length,
									)}
								</>
							) : (
								bullet.text
							)}
						</span>
					</li>
				))
			}
		</ul>

		<div class="mt-8 flex flex-wrap items-center gap-4">
			<Button href={courseHref(course.id)}>Explore {title}</Button>
			<p class="text-sm text-text-muted">
				<span class="font-display text-lg font-semibold text-text-heading">{formatPrice(price)}</span>
				<span class="ml-2">· 365-day access</span>
			</p>
		</div>
	</div>

	<div class="relative min-h-[240px] bg-card-header lg:min-h-full">
		{
			cover ? (
				<Image
					src={cover}
					alt={`${title} course cover`}
					width={cover.width}
					height={cover.height}
					class="h-full w-full object-cover"
					loading="eager"
				/>
			) : (
				<div class="flex h-full min-h-[240px] items-center justify-center bg-card-header px-8 text-center">
					<p class="font-display text-xl font-semibold text-text-inverse">{title}</p>
				</div>
			)
		}
	</div>
</article>
