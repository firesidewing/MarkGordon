---
interface Material {
	label: string;
	url: string;
}

interface Props {
	materials: Material[];
}

const { materials } = Astro.props;
---

{
	materials.length > 0 && (
		<section aria-labelledby="materials-heading">
			<h2 id="materials-heading" class="font-display text-h2 font-h2 uppercase tracking-h2 text-brand">
				Workbooks &amp; materials
			</h2>
			<ul class="mt-4 space-y-2">
				{materials.map((material) => (
					<li>
						<a href={material.url} class="inline-flex items-center gap-2 text-sm text-brand hover:underline">
							<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
								<path d="M12 3v12m0 0l4-4m-4 4l-4-4M4 19h16" />
							</svg>
							{material.label}
						</a>
					</li>
				))}
			</ul>
			<p class="mt-3 text-xs text-text-muted">Full workbook access unlocks after purchase.</p>
		</section>
	)
}
