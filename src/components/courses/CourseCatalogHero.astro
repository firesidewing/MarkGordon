---
import Button from '@/components/ui/Button.astro';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import NewsletterCta from '@/components/sections/NewsletterCta.astro';
import Section from '@/components/ui/Section.astro';
import { hubspot } from '@/config/site';
import { catalogHero } from '@/data/online-courses';

interface Props {
	courseCount: number;
	lowestPrice: number;
	accessDays: number;
}

const { courseCount, lowestPrice, accessDays } = Astro.props;
---

<section class="bg-surface" aria-labelledby="catalog-hero-heading">
	<div
		class="mx-auto w-full max-w-content px-4 py-[var(--spacing-hero-y)] pb-8 sm:px-6 sm:pb-[var(--spacing-hero-y)] lg:px-8"
	>
		<div class="mx-auto max-w-[var(--width-hero-copy)]">
			<p
				class="font-display text-[length:var(--text-eyebrow)] font-semibold uppercase tracking-[var(--tracking-eyebrow)] text-brand hero-enter"
			>
				Learn at home
			</p>
			<h1
				id="catalog-hero-heading"
				class="mt-2 text-balance font-display text-[length:var(--text-hero)] font-[number:var(--font-weight-hero)] leading-[var(--text-hero--line-height)] tracking-[var(--tracking-hero)] text-text-heading hero-enter hero-enter--1"
			>
				{catalogHero.title}
			</h1>
			<p class="mt-4 max-w-[44ch] text-base font-medium leading-relaxed text-text hero-enter hero-enter--2">
				{catalogHero.subtitle}
			</p>
			<p class="mt-4 max-w-[44ch] text-base leading-relaxed text-text-muted hero-enter hero-enter--2">
				{catalogHero.hook}
			</p>
			<dl
				class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-sm text-text-muted hero-enter hero-enter--3"
			>
				<div>
					<dt class="sr-only">Courses</dt>
					<dd>
						<span class="font-display text-lg font-semibold text-text-heading">{courseCount}</span> courses
					</dd>
				</div>
				<div>
					<dt class="sr-only">Starting price</dt>
					<dd>
						From <span class="font-display text-lg font-semibold text-text-heading">${lowestPrice}</span>
					</dd>
				</div>
				<div>
					<dt class="sr-only">Access</dt>
					<dd>
						<span class="font-display text-lg font-semibold text-text-heading">{accessDays}</span>-day access each
					</dd>
				</div>
			</dl>
			<div class="mt-8 hero-enter hero-enter--3">
				<Button href="#featured-course" variant="secondary">
					Browse courses
				</Button>
			</div>
		</div>
	</div>
</section>

<style>
	.hero-enter {
		animation: hero-rise 0.85s cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	.hero-enter--1 {
		animation-delay: 0.08s;
	}

	.hero-enter--2 {
		animation-delay: 0.16s;
	}

	.hero-enter--3 {
		animation-delay: 0.24s;
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(1rem);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-enter {
			animation: none;
		}
	}
</style>
