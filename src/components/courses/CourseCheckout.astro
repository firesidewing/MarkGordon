---
import Button from '@/components/ui/Button.astro';
import { formatPrice } from '@/lib/courses';
import { getClerkPlanId } from '@/config/billing';

interface Props {
	courseSlug: string;
	price: number;
	class?: string;
	compact?: boolean;
}

const { courseSlug, price, class: className, compact = false } = Astro.props;
const planId = getClerkPlanId(courseSlug);
const purchaseHref = `/courses/${courseSlug}/purchase/`;
const buttonClass = compact
	? '!min-h-10 !px-4 !py-2 !text-xs'
	: 'w-full sm:w-auto';
---

<div class:list={[className]}>
	{
		!planId ? (
			<p class="text-sm text-text-muted">
				Checkout is not configured for this course yet. Contact support to enroll.
			</p>
		) : (
			<div class="space-y-3">
				<Button href={purchaseHref} class={buttonClass}>
					Buy now · {formatPrice(price)}
				</Button>
				<p class="text-sm text-text-muted">
					You'll sign in or create an account on the next step. Checkout loads only when you continue.
				</p>
			</div>
		)
	}
</div>
