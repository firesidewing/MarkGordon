---
import {
	Show,
	SignInButton,
	SignUpButton,
	__experimental_CheckoutButton as CheckoutButton,
} from '@clerk/astro/components';
import { clerkAppearance } from '@/config/clerk-appearance';
import { formatPrice } from '@/lib/courses';
import { getClerkPlanId } from '@/config/billing';

interface Props {
	courseSlug: string;
	price: number;
	class?: string;
	compact?: boolean;
}

const { courseSlug, price, class: className, compact = false } = Astro.props;
const planId = getClerkPlanId(courseSlug);
const buttonClass = compact
	? 'inline-flex shrink-0 items-center justify-center rounded bg-brand px-4 py-2 font-display text-xs font-medium uppercase tracking-wide text-text-inverse transition-colors hover:bg-brand-dark'
	: 'inline-flex w-full items-center justify-center rounded bg-brand px-6 py-2 font-display text-button font-button uppercase text-text-inverse transition-colors hover:bg-brand-dark';
---

<div class:list={[className]}>
	{
		!planId ? (
			<p class="text-sm text-text-muted">
				Checkout is not configured for this course yet. Contact support to enroll.
			</p>
		) : (
			<>
				<Show when="signed-out">
					<div class="space-y-3">
						<p class="text-sm text-text-muted">Sign in or create an account to purchase.</p>
						<div class="flex flex-wrap gap-3">
							<SignInButton
								mode="redirect"
								forceRedirectUrl={`/courses/${courseSlug}/`}
								appearance={clerkAppearance}
								class={buttonClass}
							>
								Sign in to buy — {formatPrice(price)}
							</SignInButton>
							<SignUpButton
								mode="redirect"
								forceRedirectUrl={`/courses/${courseSlug}/`}
								appearance={clerkAppearance}
								class="inline-flex items-center justify-center rounded border border-brand px-6 py-2 font-display text-button font-button uppercase text-brand transition-colors hover:bg-brand/5"
							>
								Create account
							</SignUpButton>
						</div>
					</div>
				</Show>

				<Show when="signed-in">
					<CheckoutButton
						planId={planId}
						planPeriod="annual"
						for="user"
						newSubscriptionRedirectUrl="/registration-success/"
						appearance={clerkAppearance}
						class={buttonClass}
					>
						Buy now — {formatPrice(price)}
					</CheckoutButton>
				</Show>
			</>
		)
	}
	<p class="mt-3 text-xs text-text-muted">365 days of access · secure checkout</p>
</div>
