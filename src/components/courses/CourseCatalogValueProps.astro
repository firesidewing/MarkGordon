---
interface ValueProp {
	title: string;
	description: string;
}

interface Props {
	items: readonly ValueProp[];
}

const { items } = Astro.props;
---

<section class="bg-surface-muted" aria-labelledby="catalog-value-heading">
	<div class="mx-auto w-full max-w-content px-4 py-12 sm:px-6 lg:px-8 lg:py-14">
		<h2 id="catalog-value-heading" class="sr-only">Why these courses</h2>
		<ul class="grid gap-8 sm:grid-cols-3 sm:gap-6 lg:gap-10" role="list">
			{
				items.map((item) => (
					<li>
						<h3 class="font-display text-base font-semibold text-text-heading">{item.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-text-muted">{item.description}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
