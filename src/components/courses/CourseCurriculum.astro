---
import type { CollectionEntry } from 'astro:content';

interface Props {
	lessons: CollectionEntry<'courses'>['data']['lessons'];
}

const { lessons } = Astro.props;
const sorted = [...lessons].sort((a, b) => a.order - b.order);
---

<section aria-labelledby="curriculum-heading">
	<h2 id="curriculum-heading" class="font-display text-h2 font-h2 uppercase tracking-h2 text-brand">
		What you'll cover
	</h2>
	<ol class="mt-6 divide-y divide-surface-muted border-y border-surface-muted">
		{
			sorted.map((lesson) => (
				<li class="flex gap-4 py-4">
					<span class="w-6 shrink-0 font-display text-sm font-semibold text-text-muted">{lesson.order}</span>
					<div class="min-w-0">
						<p class="font-display text-base font-semibold text-text-heading">{lesson.title}</p>
						{lesson.videoUrls.length > 1 && (
							<p class="mt-1 text-xs text-text-muted">{lesson.videoUrls.length} videos</p>
						)}
					</div>
				</li>
			))
		}
	</ol>
</section>
