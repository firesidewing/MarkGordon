---
import CourseCheckout from '@/components/courses/CourseCheckout.astro';
import { formatPrice } from '@/lib/courses';

interface Props {
	title: string;
	price: number;
	courseSlug: string;
}

const { title, price, courseSlug } = Astro.props;
---

<div class="fixed inset-x-0 bottom-0 z-40 border-t border-surface-muted bg-surface/95 px-4 py-3 shadow-lg backdrop-blur-sm md:hidden">
	<div class="mx-auto flex max-w-content items-center justify-between gap-4">
		<div class="min-w-0">
			<p class="truncate font-display text-sm font-semibold text-text-heading">{title}</p>
			<p class="text-xs text-text-muted">{formatPrice(price)} · 365-day access</p>
		</div>
		<CourseCheckout courseSlug={courseSlug} price={price} compact />
	</div>
</div>
