---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import YouTube from '@/components/islands/YouTube.svelte';
import { formatPrice } from '@/lib/courses';
import { youTubeThumbnailUrl } from '@/utils/youtube';

interface Props {
	title: string;
	subtitle: string;
	hook?: string;
	audienceNote?: string;
	price: number;
	lessonCount: number;
	workbookCount: number;
	accessDays: number;
	badge?: string;
	cover?: ImageMetadata;
	introVideoId?: string;
}

const {
	title,
	subtitle,
	hook,
	audienceNote,
	price,
	lessonCount,
	workbookCount,
	accessDays,
	badge,
	cover,
	introVideoId,
} = Astro.props;
---

<section class="bg-brand">
	<div class="mx-auto grid w-full max-w-content items-center gap-8 px-4 py-12 sm:px-6 lg:grid-cols-2 lg:gap-12 lg:px-8 lg:py-16">
		<div>
			{
				badge && (
					<p class="font-display text-xs font-semibold uppercase tracking-widest text-text-inverse/80">{badge}</p>
				)
			}
			<p class="mt-2 font-display text-xs font-semibold uppercase tracking-widest text-text-inverse/70">Online course</p>
			<h1 class="mt-3 font-display text-[clamp(2rem,4.5vw,3rem)] font-bold leading-tight text-text-inverse">
				{title}
			</h1>
			<p class="mt-3 text-lg font-medium text-text-inverse/95">{subtitle}</p>
			{
				hook && (
					<p class="mt-4 max-w-prose text-sm leading-relaxed text-text-inverse/85">{hook}</p>
				)
			}
			{
				audienceNote && (
					<p class="mt-4 max-w-prose text-sm leading-relaxed text-text-inverse/75">{audienceNote}</p>
				)
			}
			<dl class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-text-inverse/85">
				<div>
					<dt class="sr-only">Price</dt>
					<dd class="font-display text-xl font-semibold text-text-inverse">{formatPrice(price)}</dd>
				</div>
				<div>
					<dt class="sr-only">Lessons</dt>
					<dd>{lessonCount} video lessons</dd>
				</div>
				{
					workbookCount > 0 && (
						<div>
							<dt class="sr-only">Workbooks</dt>
							<dd>{workbookCount} workbooks</dd>
						</div>
					)
				}
				<div>
					<dt class="sr-only">Access</dt>
					<dd>{accessDays}-day access</dd>
				</div>
			</dl>
		</div>

		<div class="overflow-hidden rounded-sm shadow-lg">
			{
				introVideoId ? (
					<YouTube
						client:visible
						videoId={introVideoId}
						title={`${title} course introduction`}
						posterSrc={cover?.src ?? youTubeThumbnailUrl(introVideoId)}
						posterWidth={cover?.width}
						posterHeight={cover?.height}
						playStyle="hero"
					/>
				) : (
					cover && (
						<Image
							src={cover}
							alt={`${title} course cover`}
							width={cover.width}
							height={cover.height}
							class="h-auto w-full object-cover"
							loading="eager"
						/>
					)
				)
			}
		</div>
	</div>
</section>
