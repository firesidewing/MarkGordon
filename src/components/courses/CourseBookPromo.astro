---
import Button from '@/components/ui/Button.astro';

interface Props {
	href: string;
}

const { href } = Astro.props;
---

<section
	class="rounded-sm border border-surface-muted bg-surface-muted/60 p-6"
	aria-labelledby="book-promo-heading"
>
	<h2 id="book-promo-heading" class="font-display text-lg font-semibold text-text-heading">
		Prefer to read first?
	</h2>
	<p class="mt-2 text-sm leading-relaxed text-text-muted">
		This course is based on the Relationship Matters book — the essential blueprint for building strong
		families and fostering healthy relationships at home.
	</p>
	<div class="mt-4">
		<Button href={href}>View the book</Button>
	</div>
</section>
