---
interface Pillar {
	title: string;
	description: string;
}

interface Props {
	pillars: Pillar[];
}

const { pillars } = Astro.props;
---

<section class="bg-surface-muted" aria-labelledby="pillars-heading">
	<div class="mx-auto w-full max-w-content px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
		<h2 id="pillars-heading" class="font-display text-h2 font-h2 uppercase tracking-h2 text-brand">
			The five pillars
		</h2>
		<p class="mt-3 max-w-2xl text-sm leading-relaxed text-text-muted">
			Every lesson in this course builds one pillar of your relational foundation.
		</p>
		<ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8" role="list">
			{
				pillars.map((pillar, index) => (
					<li class="rounded-sm border border-surface-muted bg-surface p-5 shadow-sm">
						<p class="font-display text-xs font-semibold uppercase tracking-widest text-brand">
							Pillar {index + 1}
						</p>
						<h3 class="mt-2 font-display text-lg font-semibold text-text-heading">{pillar.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-text-muted">{pillar.description}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>
