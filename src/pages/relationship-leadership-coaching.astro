---
import { Image } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { hubspot } from '@/config/site';
import {
	coachingApproach,
	coachingHero,
	coachingIntro,
	coachingOptions,
	coachingTestimonials,
	premiumPackages,
} from '@/data/relationship-leadership-coaching';
import portraitImage from '@/assets/content/relationship-leadership-coaching/Mark-38sq-1024x1024.jpg';

const seoTitle = 'Relationship & Leadership Coaching';
const description =
	'Relationship and leadership coaching to help families and organizations heal from the inside out.';
---

<BaseLayout title={seoTitle} description={description}>
	<section class="bg-brand">
		<div
			class="mx-auto grid w-full max-w-content items-center gap-8 px-4 py-12 sm:px-6 sm:py-16 lg:grid-cols-2 lg:gap-12 lg:px-8"
		>
			<h1
				class="font-display text-2xl font-h2 uppercase tracking-h2 text-text-inverse sm:text-3xl lg:text-[2.25rem]"
			>
				Relationship & Leadership Coaching
			</h1>
			<p class="text-base leading-relaxed text-text-inverse/90">{coachingHero}</p>
		</div>
	</section>

	<section class="mx-auto w-full max-w-content px-4 py-12 sm:px-6 lg:px-8">
		<p class="text-[0.9375rem] leading-relaxed text-text sm:text-base">{coachingIntro}</p>

		<h2 class="mt-10 font-display text-xl font-semibold text-brand sm:text-[1.375rem]">
			My Approach is Three-Fold:
		</h2>
		<div class="mt-6 grid gap-8 lg:grid-cols-3 lg:gap-10">
			{
				coachingApproach.map((item) => (
					<p class="text-[0.9375rem] leading-relaxed text-text sm:text-base">
						<strong>{item.label}</strong> {item.body}
					</p>
				))
			}
		</div>
	</section>

	<section class="bg-brand">
		<div class="mx-auto w-full max-w-content px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
			<h2
				class="text-center font-display text-xl font-semibold text-text-inverse sm:text-[1.375rem]"
			>
				Coaching Options
			</h2>
			<div class="mx-auto mt-8 grid max-w-2xl gap-8 sm:grid-cols-2 sm:gap-12">
				{
					coachingOptions.map((column) => (
						<ul class="space-y-3" role="list">
							{column.map((option) => (
								<li class="flex gap-2.5 text-[0.9375rem] leading-relaxed text-text-inverse sm:text-base">
									<span
										class="mt-1.5 flex h-2.5 w-2.5 shrink-0 items-center justify-center rounded-full bg-text-inverse"
										aria-hidden="true"
									>
										<span class="h-1 w-1 rounded-full bg-brand" />
									</span>
									<span>{option}</span>
								</li>
							))}
						</ul>
					))
				}
			</div>
		</div>
	</section>

	<section class="mx-auto w-full max-w-content px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
		<div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-12">
			<div class="text-center">
				<h2 class="font-display text-xl font-semibold text-brand sm:text-[1.375rem]">
					{premiumPackages.title}
				</h2>
				<div class="mx-auto mt-3 h-1 w-12 bg-brand" aria-hidden="true" />
				<p class="mt-6 text-[0.9375rem] leading-relaxed text-text sm:text-base">
					{premiumPackages.body}
				</p>
				<div class="mt-8">
					<Button
						href={hubspot.discoveryCall}
						external
						class="rounded-button px-11 py-3.5"
					>
						Book Discovery Call
					</Button>
				</div>
			</div>
			<div class="overflow-hidden">
				<Image
					src={portraitImage}
					alt="Mark Gordon in a coaching session"
					width={portraitImage.width}
					height={portraitImage.height}
					class="h-auto w-full object-cover"
					loading="eager"
				/>
			</div>
		</div>
	</section>

	<section class="bg-brand" aria-labelledby="coaching-testimonials-heading">
		<div class="mx-auto w-full max-w-content px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
			<h2
				id="coaching-testimonials-heading"
				class="text-center font-display text-2xl font-semibold text-text-inverse sm:text-[1.75rem]"
			>
				What people say?
			</h2>
			<div class="mt-10 grid gap-10 lg:grid-cols-3 lg:gap-8">
				{
					coachingTestimonials.map((testimonial) => (
						<blockquote class="text-[0.9375rem] leading-relaxed text-text-inverse sm:text-base">
							<svg
								class="mb-4 h-8 w-8 text-text-inverse/80"
								viewBox="0 0 24 24"
								fill="currentColor"
								aria-hidden="true"
							>
								<path d="M7.17 6A5 5 0 0 0 2 11v7h7v-7H6.17A3.17 3.17 0 0 1 9.34 8 3.17 3.17 0 0 1 12.51 11H15.5A5.5 5.5 0 0 0 7.17 6zm10 0a5 5 0 0 0-5.17 5v7h7v-7h-2.83A3.17 3.17 0 0 1 17.17 8 3.17 3.17 0 0 1 20.34 11h2.99A5.5 5.5 0 0 0 17.17 6z" />
							</svg>
							<p>&ldquo;{testimonial.quote}&rdquo;</p>
							<cite class="mt-6 block text-sm not-italic">
								<span class="block">- {testimonial.author}</span>
								{testimonial.role && (
									<span class="mt-1 block text-xs font-semibold uppercase tracking-wide text-text-inverse/80">
										{testimonial.role}
									</span>
								)}
							</cite>
						</blockquote>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>
