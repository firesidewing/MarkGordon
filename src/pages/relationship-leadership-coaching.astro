---
export const prerender = true;

import { Image } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import CoachingBookingClose from '@/components/sections/CoachingBookingClose.astro';
import CoachingHero from '@/components/sections/CoachingHero.astro';
import CoachingStickyBar from '@/components/sections/CoachingStickyBar.astro';
import CoachingTestimonials from '@/components/sections/CoachingTestimonials.astro';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import Section from '@/components/ui/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
	coachingAbout,
	coachingAccelerator,
	coachingApproach,
	coachingAudiences,
	coachingBlindSpot,
	coachingDeeperConnection,
	coachingFocusAreas,
	coachingOpening,
	coachingOptions,
	coachingProcess,
	coachingRelational,
	coachingSeo,
	coachingWhyMark,
} from '@/data/relationship-leadership-coaching';
import portraitImage from '@/assets/content/relationship-leadership-coaching/Mark-38sq-1024x1024.jpg';
---

<BaseLayout title={coachingSeo.title} description={coachingSeo.description}>
	<div class="pb-20 md:pb-0">
		<CoachingHero />

		<Section>
			<div class="mx-auto max-w-3xl">
				<h2
					class="text-balance font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
				>
					{coachingOpening.title}
				</h2>
				<div class="mt-6 space-y-2 text-base leading-relaxed text-text">
					{
						coachingOpening.lines.map((line) => (
							<p>{line}</p>
						))
					}
				</div>
				<p class="mt-6 text-base italic leading-relaxed text-text-heading">
					&ldquo;{coachingOpening.insight}&rdquo;
				</p>
				<p class="mt-6 text-base leading-relaxed text-text">{coachingOpening.closing}</p>
			</div>
		</Section>

		<Section variant="muted">
			<div class="mx-auto max-w-3xl">
				<h2
					class="text-balance font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
				>
					{coachingAbout.title}
				</h2>
				<p class="mt-4 text-lg font-semibold text-brand">{coachingAbout.intro}</p>
				<p class="mt-4 text-base leading-relaxed text-text">{coachingAbout.body}</p>
				<p class="mt-8 font-display text-sm font-semibold uppercase tracking-wide text-text-heading">
					{coachingAbout.exploreLabel}
				</p>
				<ul class="mt-4 grid gap-2 sm:grid-cols-2" role="list">
					{
						coachingAbout.exploreItems.map((item) => (
							<li class="flex gap-2.5 text-base leading-relaxed text-text">
								<span
									class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"
									aria-hidden="true"
								/>
								{item}
							</li>
						))
					}
				</ul>
				<p class="mt-8 text-base font-semibold leading-relaxed text-text-heading">
					{coachingAbout.goal}
				</p>
			</div>
		</Section>

		<Section>
			<SectionHeading title={coachingAudiences.title} centered class="mb-10" />
			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
				{
					coachingAudiences.audiences.map((audience) => (
						<article class="border-t-2 border-brand bg-surface px-5 py-5 shadow-sm sm:px-6 sm:py-6">
							<h3 class="font-display text-h4 font-semibold leading-snug text-text-heading">
								{audience.title}
							</h3>
							<p class="mt-3 text-sm leading-relaxed text-text sm:text-base">
								{audience.description}
							</p>
						</article>
					))
				}
			</div>
		</Section>

		<Section variant="muted">
			<div class="mx-auto max-w-3xl">
				<h2
					class="text-balance font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
				>
					{coachingFocusAreas.title}
				</h2>
				<p class="mt-4 text-base leading-relaxed text-text">{coachingFocusAreas.intro}</p>

				<div class="mt-8 space-y-3 md:hidden">
					{
						coachingFocusAreas.areas.map((area) => (
							<details class="group border border-surface-muted bg-surface">
								<summary
									class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-display text-base font-semibold text-text-heading [&::-webkit-details-marker]:hidden"
								>
									<span>{area.title}</span>
									<span
										class="text-brand transition-transform group-open:rotate-180 motion-reduce:transition-none"
										aria-hidden="true"
									>
										<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
											<path
												fill-rule="evenodd"
												d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
												clip-rule="evenodd"
											/>
										</svg>
									</span>
								</summary>
								<div class="border-t border-surface-muted px-5 py-4">
									<p class="text-sm leading-relaxed text-text">{area.question}</p>
								</div>
							</details>
						))
					}
				</div>

				<div class="mt-8 hidden gap-4 sm:grid-cols-2 md:grid lg:grid-cols-3">
					{
						coachingFocusAreas.areas.map((area) => (
							<article class="border-t-2 border-brand bg-surface px-5 py-5 shadow-sm sm:px-6 sm:py-6">
								<h3 class="font-display text-h4 font-semibold leading-snug text-text-heading">
									{area.title}
								</h3>
								<p class="mt-3 text-sm leading-relaxed text-text sm:text-base">{area.question}</p>
							</article>
						))
					}
				</div>
			</div>
		</Section>

		<Section>
			<div class="mx-auto max-w-3xl text-center">
				<h2
					class="text-balance font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
				>
					{coachingBlindSpot.title}
				</h2>
				<div class="mt-6 space-y-4 text-base leading-relaxed text-text">
					{
						coachingBlindSpot.paragraphs.map((paragraph) => (
							<p>{paragraph}</p>
						))
					}
				</div>
				<div class="mt-8">
					<Button href={coachingBlindSpot.href}>{coachingBlindSpot.cta}</Button>
				</div>
			</div>
		</Section>

		<Section variant="muted">
			<div class="mx-auto max-w-3xl">
				<h2
					class="text-balance text-center font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
				>
					{coachingRelational.title}
				</h2>
				<div class="mt-6 space-y-4 text-center text-base leading-relaxed text-text">
					{
						coachingRelational.paragraphs.map((paragraph) => (
							<p>{paragraph}</p>
						))
					}
				</div>
			</div>
		</Section>

		<Section>
			<SectionHeading title={coachingApproach.title} centered class="mb-10" />
			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
				{
					coachingApproach.pillars.map((pillar) => (
						<article class="border-t-2 border-brand bg-surface px-5 py-5 shadow-sm sm:px-6 sm:py-6">
							<h3 class="font-display text-h4 font-semibold leading-snug text-text-heading">
								{pillar.title}
							</h3>
							<p class="mt-3 text-sm leading-relaxed text-text sm:text-base">
								{pillar.description}
							</p>
						</article>
					))
				}
			</div>
		</Section>

		<Section variant="muted">
			<div class="mx-auto max-w-3xl">
				<h2
					class="text-balance text-center font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
				>
					{coachingProcess.title}
				</h2>
				<p class="mt-6 text-center text-base leading-relaxed text-text">{coachingProcess.intro}</p>
				<p
					class="mt-8 text-center font-display text-sm font-semibold uppercase tracking-wide text-text-heading"
				>
					{coachingProcess.stepsLabel}
				</p>
				<ol class="mt-6 space-y-0" role="list">
					{
						coachingProcess.steps.map((step, index) => (
							<li>
								<div class="border-t-2 border-brand bg-surface px-5 py-5 shadow-sm sm:px-6 sm:py-6">
									<h3 class="font-display text-h4 font-semibold leading-snug text-text-heading">
										{step.title}
									</h3>
									<p class="mt-2 text-sm leading-relaxed text-text sm:text-base">
										{step.description}
									</p>
								</div>
								{index < coachingProcess.steps.length - 1 && (
									<div
										class="flex justify-center py-2 text-brand"
										aria-hidden="true"
									>
										<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
											<path
												fill-rule="evenodd"
												d="M10 3a.75.75 0 01.75.75v10.638l3.96-4.158a.75.75 0 111.08 1.04l-5.25 5.5a.75.75 0 01-1.08 0l-5.25-5.5a.75.75 0 111.08-1.04l3.96 4.158V3.75A.75.75 0 0110 3z"
												clip-rule="evenodd"
											/>
										</svg>
									</div>
								)}
							</li>
						))
					}
				</ol>
			</div>
		</Section>

		<Section>
			<div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-12">
				<div>
					<h2
						class="text-balance font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
					>
						{coachingWhyMark.title}
					</h2>
					<div class="mt-6 space-y-4 text-base leading-relaxed text-text">
						{
							coachingWhyMark.paragraphs.map((paragraph) => (
								<p>{paragraph}</p>
							))
						}
					</div>
				</div>
				<div class="overflow-hidden">
					<Image
						src={portraitImage}
						alt="Mark Gordon, leadership coach"
						width={portraitImage.width}
						height={portraitImage.height}
						class="h-auto w-full object-cover"
						loading="lazy"
					/>
				</div>
			</div>
		</Section>

		<Section variant="muted">
			<div class="mx-auto max-w-3xl">
				<h2
					class="text-balance text-center font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
				>
					{coachingDeeperConnection.title}
				</h2>
				<div class="mt-6 space-y-4 text-center text-base leading-relaxed text-text">
					{
						coachingDeeperConnection.paragraphs.map((paragraph) => (
							<p>{paragraph}</p>
						))
					}
				</div>
			</div>
		</Section>

		<Section>
			<div class="mx-auto max-w-3xl text-center">
				<h2
					class="text-balance font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
				>
					{coachingAccelerator.title}
				</h2>
				<p class="mt-4 text-base leading-relaxed text-text">{coachingAccelerator.body}</p>
				<div class="mt-8">
					<Button href={coachingAccelerator.href}>{coachingAccelerator.cta}</Button>
				</div>
			</div>
		</Section>

		<CoachingTestimonials />

		<Section>
			<SectionHeading title={coachingOptions.title} centered class="mb-10" />
			<div class="grid gap-6 lg:grid-cols-3 lg:gap-8">
				{
					coachingOptions.options.map((option) => (
						<article class="flex flex-col border-t-2 border-brand bg-surface px-6 py-8 shadow-sm">
							<h3 class="font-display text-h4 font-semibold leading-snug text-text-heading">
								{option.title}
							</h3>
							<p class="mt-4 flex-1 text-base leading-relaxed text-text">{option.description}</p>
							<div class="mt-8">
								<a
									href={option.href}
									class="link-interactive font-display text-sm font-semibold uppercase tracking-wide text-brand hover:underline"
								>
									{option.cta} →
								</a>
							</div>
						</article>
					))
				}
			</div>
		</Section>

		<CoachingBookingClose />
		<CoachingStickyBar />
	</div>
</BaseLayout>
