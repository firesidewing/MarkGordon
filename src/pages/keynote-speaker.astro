---
import { Image } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { hubspot } from '@/config/site';
import {
	keynoteIntro,
	keynoteTestimonials,
	keynoteTopics,
} from '@/data/keynote-speaker';
import speakingImage from '@/assets/content/keynote-speaker/tsg-9.jpg';

const seoTitle = 'Empowering Keynote Speaking Delivered with Practicality';
const description =
	'Helping people to develop healthy relationships, with God, themselves & others, through transformational keynote speaking.';
---

<BaseLayout title={seoTitle} description={description}>
	<section class="bg-brand">
		<div
			class="mx-auto grid w-full max-w-content items-center gap-8 px-4 py-12 sm:px-6 sm:py-16 lg:grid-cols-2 lg:gap-12 lg:px-8"
		>
			<h1
				class="font-display text-2xl font-h2 uppercase tracking-h2 text-text-inverse sm:text-3xl lg:text-[2.25rem]"
			>
				Keynote Speaker
			</h1>
			<p class="text-base leading-relaxed text-text-inverse/90">{keynoteIntro.hero}</p>
		</div>
	</section>

	<section class="mx-auto w-full max-w-content px-4 py-12 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-3xl text-center">
			<p class="text-[0.9375rem] font-semibold leading-relaxed text-text sm:text-base">
				{keynoteIntro.lead}
			</p>
			<p class="mt-4 text-[0.9375rem] leading-relaxed text-text sm:text-base">
				{keynoteIntro.body}
			</p>
		</div>
	</section>

	<section class="mx-auto w-full max-w-content px-4 pb-12 sm:px-6 lg:px-8 lg:pb-16">
		<div class="grid items-start gap-10 lg:grid-cols-2 lg:gap-12">
			<div class="overflow-hidden">
				<Image
					src={speakingImage}
					alt="Mark Gordon speaking to a group"
					width={speakingImage.width}
					height={speakingImage.height}
					class="h-auto w-full object-cover"
					loading="eager"
				/>
			</div>
			<div class="grid gap-8 sm:grid-cols-2">
				{
					keynoteTopics.map((column) => (
						<ul class="space-y-3" role="list">
							{column.map((topic) => (
								<li class="flex gap-2.5 text-[0.9375rem] leading-relaxed text-text sm:text-base">
									<svg
										class="mt-1.5 h-2.5 w-2.5 shrink-0 text-brand"
										viewBox="0 0 10 10"
										fill="currentColor"
										aria-hidden="true"
									>
										<circle cx="5" cy="5" r="5" />
									</svg>
									<span>{topic}</span>
								</li>
							))}
						</ul>
					))
				}
			</div>
		</div>
	</section>

	<section class="mx-auto w-full max-w-content px-4 pb-12 text-center sm:px-6 lg:px-8 lg:pb-16">
		<p class="text-[0.9375rem] italic leading-relaxed text-text-muted sm:text-base">
			{keynoteIntro.tagline}
		</p>
		<div class="mt-8">
			<Button
				href={hubspot.discoveryCall}
				external
				class="rounded-button px-11 py-3.5"
			>
				Book Discovery Call
			</Button>
		</div>
	</section>

	<section class="bg-brand" aria-labelledby="keynote-testimonials-heading">
		<div class="mx-auto w-full max-w-content px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
			<h2
				id="keynote-testimonials-heading"
				class="text-center font-display text-2xl font-semibold text-text-inverse sm:text-[1.75rem]"
			>
				What people say?
			</h2>
			<div class="mt-10 grid gap-10 lg:grid-cols-3 lg:gap-8">
				{
					keynoteTestimonials.map((testimonial) => (
						<blockquote class="text-[0.9375rem] leading-relaxed text-text-inverse sm:text-base">
							<svg
								class="mb-4 h-8 w-8 text-text-inverse/80"
								viewBox="0 0 24 24"
								fill="currentColor"
								aria-hidden="true"
							>
								<path d="M7.17 6A5 5 0 0 0 2 11v7h7v-7H6.17A3.17 3.17 0 0 1 9.34 8 3.17 3.17 0 0 1 12.51 11H15.5A5.5 5.5 0 0 0 7.17 6zm10 0a5 5 0 0 0-5.17 5v7h7v-7h-2.83A3.17 3.17 0 0 1 17.17 8 3.17 3.17 0 0 1 20.34 11h2.99A5.5 5.5 0 0 0 17.17 6z" />
							</svg>
							<p>{testimonial.quote}</p>
							<cite class="mt-6 block text-sm not-italic">
								<span class="block">- {testimonial.author}</span>
								{testimonial.role && (
									<span class="mt-1 block text-xs font-semibold uppercase tracking-wide text-text-inverse/80">
										{testimonial.role}
									</span>
								)}
							</cite>
						</blockquote>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>
