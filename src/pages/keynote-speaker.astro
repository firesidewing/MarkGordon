---
export const prerender = true;

import AdditionalSpeakingTopics from '@/components/sections/AdditionalSpeakingTopics.astro';
import AudiencesMarkServes from '@/components/sections/AudiencesMarkServes.astro';
import EventOrganizerFaq from '@/components/sections/EventOrganizerFaq.astro';
import SignatureKeynotes from '@/components/sections/SignatureKeynotes.astro';
import SpeakingBookingClose from '@/components/sections/SpeakingBookingClose.astro';
import SpeakingHero from '@/components/sections/SpeakingHero.astro';
import SpeakingPhilosophy from '@/components/sections/SpeakingPhilosophy.astro';
import SpeakingTestimonials from '@/components/sections/SpeakingTestimonials.astro';
import WhyMarkSpeaking from '@/components/sections/WhyMarkSpeaking.astro';
import WorkshopsTeaser from '@/components/sections/WorkshopsTeaser.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { speakingSeo } from '@/data/keynote-speaker';
---

<BaseLayout title={speakingSeo.title} description={speakingSeo.description}>
	<SpeakingHero />
	<div class="flex flex-col">
		<WhyMarkSpeaking />
		<SpeakingPhilosophy />
		<SignatureKeynotes />
	</div>
	<AdditionalSpeakingTopics />
	<WorkshopsTeaser />
	<AudiencesMarkServes />
	<SpeakingTestimonials />
	<EventOrganizerFaq />
	<SpeakingBookingClose />
</BaseLayout>
