---
import { getCollection, getEntry, render } from 'astro:content';
import MarketingPage from '@/layouts/MarketingPage.astro';
import BlogPost from '@/layouts/BlogPost.astro';
import { site } from '@/config/site';
import { RESERVED_PAGE_SLUGS } from '@/utils/content';
import { pageFeaturedImages, pageHeroImages } from '@/utils/page-images';

export async function getStaticPaths() {
	const [pages, posts] = await Promise.all([getCollection('pages'), getCollection('blog')]);

	const pagePaths = pages
		.filter((entry) => !entry.data.draft && !RESERVED_PAGE_SLUGS.has(entry.data.slug))
		.map((entry) => ({
			params: { slug: entry.data.slug },
			props: { kind: 'page' as const, id: entry.id },
		}));

	const postPaths = posts
		.filter((entry) => !entry.data.draft)
		.map((entry) => ({
			params: { slug: entry.data.slug },
			props: { kind: 'post' as const, id: entry.id },
		}));

	return [...pagePaths, ...postPaths];
}

const { kind, id } = Astro.props;

const entry = kind === 'page' ? await getEntry('pages', id) : await getEntry('blog', id);
const { Content } = await render(entry!);

const slug = entry!.data.slug;
const heroImage = kind === 'page' ? pageHeroImages[slug] : undefined;
const featuredImage = kind === 'page' ? pageFeaturedImages[slug] : undefined;
---

{
	kind === 'page' ? (
		<MarketingPage
			title={entry!.data.title}
			description={`${entry!.data.title} — ${site.tagline}`}
			intro={entry!.data.intro}
			heroImage={heroImage}
			featuredImage={featuredImage}
			heroLayout={entry!.data.heroLayout}
			contentLayout={entry!.data.contentLayout ?? (featuredImage ? 'image-left' : 'default')}
			showHero={entry!.data.showHero ?? true}
			showSidebar={entry!.data.showSidebar ?? false}
		>
			<Content />
		</MarketingPage>
	) : (
		<BlogPost post={entry!}>
			<Content />
		</BlogPost>
	)
}
