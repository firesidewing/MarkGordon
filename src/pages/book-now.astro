---
export const prerender = true;

import bookNowImg from '@/assets/content/book-now/Mark-36-e1569198052878-750x1024.jpg';
import PageHero from '@/components/sections/PageHero.astro';
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { hubspot } from '@/config/site';
---

<BaseLayout
	title="Book Mark to Speak"
	description="Book a short conversation with Mark Gordon about speaking, workshops, coaching, or leadership development for your team."
>
	<PageHero
		title="Book Mark to Speak"
		eyebrow="Speaking · Workshops · Coaching"
		intro="A 15-minute conversation is enough to talk through your event, your team, and whether Mark is the right fit."
		image={bookNowImg}
		imageAlt="Mark Gordon"
	/>

	<Section variant="muted">
		<div class="mx-auto max-w-narrow">
			<p class="font-display text-lg font-semibold leading-snug text-text-heading">
				Tell Mark what you are planning.
			</p>
			<p class="mt-4 text-base leading-relaxed text-text">
				Whether you are booking a keynote, designing a workshop, looking at Leadership Accelerator, or exploring coaching, start with a real conversation—not a form that asks you to pick a package first.
			</p>
			<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
				<Button href={hubspot.discoveryCall} external>
					Book Mark to Speak
				</Button>
				<Button href="/contact/" variant="secondary">
					Start a Conversation
				</Button>
			</div>
		</div>
	</Section>
</BaseLayout>
