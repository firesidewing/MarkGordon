---
export const prerender = true;

import PageHero from '@/components/sections/PageHero.astro';
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
	title="Videos"
	description="Mark delivers inspiring short videos and podcasts. Subscribe so you don't miss one!"
>
	<PageHero
		title="Videos & podcasts"
		eyebrow="Watch & listen"
		intro="Mark delivers inspiring short videos and podcasts. Subscribe so you don't miss one!"
	/>

	<Section>
		<div class="aspect-video w-full overflow-hidden rounded-sm bg-surface-muted shadow-sm">
			<iframe
				src="https://www.youtube.com/embed/videoseries?list=PLOiSNn4coE_6_qDKibfB6NKZjaXGAMBXm"
				title="Mark Gordon video playlist"
				allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
				allowfullscreen
				referrerpolicy="strict-origin-when-cross-origin"
				class="h-full w-full border-0"
				loading="lazy"
			></iframe>
		</div>
		<p class="mt-6 text-base leading-relaxed text-text-muted">
			Browse the full archive of relationship videos and teaching content.
		</p>
		<div class="mt-6">
			<Button href="https://www.youtube.com/@rmarkgordon" external>
				View on YouTube →
			</Button>
		</div>
	</Section>
</BaseLayout>
