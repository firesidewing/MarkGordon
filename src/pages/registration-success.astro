---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import { isBillableCourse } from '@/config/billing';
import { grantEnrollmentForCourse, syncPurchasedEnrollments } from '@/lib/enrollments';
import { isDbConfigured } from '@/lib/db';

export const prerender = false;

const { userId } = Astro.locals.auth();
if (!userId) {
	return Astro.redirect('/sign-up/');
}

const purchasedCourseSlug = Astro.url.searchParams.get('course');

if (isDbConfigured()) {
	try {
		if (purchasedCourseSlug && isBillableCourse(purchasedCourseSlug)) {
			await grantEnrollmentForCourse(userId, purchasedCourseSlug);
		}
		// Single backfill — webhook is primary; avoid multi-second retry sleeps.
		await syncPurchasedEnrollments(userId);
	} catch (error) {
		console.error('Failed to sync enrollments after checkout:', error);
	}
}
---

<BaseLayout title="Welcome" description="Your account is ready." noindex>
	<div class="mx-auto w-full max-w-content px-4 py-16 text-center sm:px-6 lg:px-8">
		<h1 class="font-display text-h2 font-h2 uppercase tracking-h2 text-brand">You're all set</h1>
		<p class="mx-auto mt-4 max-w-prose text-sm leading-relaxed text-text-muted">
			Thank you for your purchase. Your course access is being activated — it may take a moment.
			Head to your courses to start learning, or browse the catalog for your next step.
		</p>
		<div class="mt-8 flex flex-wrap justify-center gap-4">
			<Button href="/account/courses/">My courses</Button>
			<Button href="/online-courses/" variant="text" class="!text-brand">Browse courses</Button>
		</div>
	</div>
</BaseLayout>
