---
import MarketingPage from '@/layouts/MarketingPage.astro';
import Button from '@/components/ui/Button.astro';
---

<MarketingPage
	title="Blind Spot Assessment"
	intro="Discover how in just 3 minutes."
	showSidebar={false}
>
	<div class="not-prose text-center">
		<h2 class="heading-section mb-4">Would you like stronger relationships?</h2>
		<p class="mx-auto mb-8 max-w-xl text-lg leading-relaxed text-text-muted">
			Take the free blind spot assessment to uncover hidden patterns that may be holding your relationships back.
		</p>
		<Button href="https://blindspots.me/hcWAIr" external>
			Take the Free Test Now
		</Button>
	</div>
</MarketingPage>
