import AboutMessage from '@/components/sections/about/AboutMessage.astro';
import AboutPersonal from '@/components/sections/about/AboutPersonal.astro';
import AboutRelationalThread from '@/components/sections/about/AboutRelationalThread.astro';
import AboutStory from '@/components/sections/about/AboutStory.astro';
import AboutTestimonials from '@/components/sections/about/AboutTestimonials.astro';
import AboutTransition from '@/components/sections/about/AboutTransition.astro';
import AboutWhatIBring from '@/components/sections/about/AboutWhatIBring.astro';
