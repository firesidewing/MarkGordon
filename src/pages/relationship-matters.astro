---
export const prerender = true;

import BookCoursePromo from '@/components/sections/BookCoursePromo.astro';
import BookMarketingHero from '@/components/sections/BookMarketingHero.astro';
import BookRetailerGrid from '@/components/sections/BookRetailerGrid.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import CourseTestimonialBand from '@/components/courses/CourseTestimonialBand.astro';
import bookCover from '@/assets/content/relationship-matters/book-cover.png';
import { hubspot } from '@/config/site';
import {
	bookCoursePromo,
	bookHero,
	bookIntro,
	bookOutcomes,
	bookPillars,
	bookRetailers,
	bookTestimonial,
} from '@/data/relationship-matters';
import BaseLayout from '@/layouts/BaseLayout.astro';

const description = bookHero.subtitle;
---

<BaseLayout title="Relationship Matters" description={description}>
	<BookMarketingHero
		title="Relationship Matters"
		subtitle={bookHero.subtitle}
		hook={bookHero.hook}
		cover={bookCover}
	/>

	<BookRetailerGrid retailers={bookRetailers} id="retailers" />

	<section class="mx-auto w-full max-w-content px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
		<div class="mx-auto max-w-3xl text-center">
			<p class="text-lg font-medium leading-relaxed text-text-heading sm:text-xl">
				{bookIntro.lead}
			</p>
			<p class="mt-4 text-base leading-relaxed text-text">{bookIntro.body}</p>
		</div>
	</section>

	<section class="bg-surface-muted" aria-labelledby="book-sections-heading">
		<div class="mx-auto w-full max-w-content px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
			<SectionHeading
				title="Three sections, one strong house"
				subtitle="The book is organized around building a home that can weather real life — not just look good from the outside."
				centered
			/>
			<ol class="mt-10 grid gap-6 lg:grid-cols-3 lg:gap-8" role="list">
				{
					bookPillars.map((pillar, index) => (
						<li class="bg-surface p-6 shadow-sm">
							<p class="font-display text-xs font-semibold uppercase tracking-widest text-brand">
								Section {index + 1}
							</p>
							<h3 class="mt-2 font-display text-lg font-semibold text-text-heading">
								{pillar.title}
							</h3>
							<p class="mt-2 text-sm leading-relaxed text-text-muted">{pillar.description}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="mx-auto w-full max-w-content px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
		<div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
			<div>
				<h2 class="font-display text-h2 font-h2 uppercase tracking-h2 text-brand">
					What you will gain
				</h2>
				<ul class="mt-6 space-y-3" role="list">
					{
						bookOutcomes.map((outcome) => (
							<li class="flex gap-3 text-sm leading-relaxed text-text">
								<span
									class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-brand"
									aria-hidden="true"
								/>
								{outcome}
							</li>
						))
					}
				</ul>
			</div>
			<div class="flex flex-col justify-center">
				<p class="text-base leading-relaxed text-text">
					Whether you are rebuilding after a hard season or trying to get ahead of problems before
					they grow, this book gives you language, structure, and practical steps — not vague advice.
				</p>
				<div class="mt-8">
					<Button href={hubspot.discoveryCall} external>
						Book a discovery call
					</Button>
				</div>
			</div>
		</div>
	</section>

	<BookCoursePromo {...bookCoursePromo} />

	<CourseTestimonialBand {...bookTestimonial} />

	<CtaBand />
</BaseLayout>
