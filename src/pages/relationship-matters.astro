---
export const prerender = true;

import { Image } from 'astro:assets';
import CourseTestimonialBand from '@/components/courses/CourseTestimonialBand.astro';
import BookRetailerGrid from '@/components/sections/BookRetailerGrid.astro';
import RelationshipMattersHero from '@/components/sections/RelationshipMattersHero.astro';
import RelationshipMattersHouse from '@/components/sections/RelationshipMattersHouse.astro';
import RelationshipMattersPillars from '@/components/sections/RelationshipMattersPillars.astro';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import bookCover from '@/assets/content/relationship-matters/book-cover.png';
import {
	bigIdea,
	bookRetailers,
	bookSection,
	bookTestimonial,
	courseSection,
	finalCta,
	forFamilies,
	forLeaders,
	leadershipConnection,
	relationshipMattersSeo,
	speakingSection,
	whatYoullFind,
	whoIsItFor,
} from '@/data/relationship-matters';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title={relationshipMattersSeo.title} description={relationshipMattersSeo.description}>
	<RelationshipMattersHero cover={bookCover} />

	<Section>
		<div class="mx-auto max-w-3xl text-center">
			<h2
				class="text-balance font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
			>
				{bigIdea.title}
			</h2>
			<div class="mt-6 space-y-1">
				{
					bigIdea.lines.map((line) => (
						<p class="text-base font-medium leading-relaxed text-text-heading">{line}</p>
					))
				}
			</div>
			<div class="mt-6 space-y-4 text-base leading-relaxed text-text">
				{
					bigIdea.paragraphs.map((paragraph) => (
						<p>{paragraph}</p>
					))
				}
			</div>
		</div>
	</Section>

	<RelationshipMattersPillars />

	<RelationshipMattersHouse />

	<Section variant="brand">
		<div class="mx-auto max-w-3xl text-center">
			<h2
				class="text-balance font-display text-h3 font-semibold leading-snug text-text-inverse sm:text-h2 sm:leading-tight"
			>
				{leadershipConnection.title}
			</h2>
			<p class="mt-6 text-base leading-relaxed text-text-inverse/90">
				{leadershipConnection.paragraphs[0]}
			</p>
			<ul class="mt-6 space-y-2" role="list">
				{
					leadershipConnection.bullets.map((bullet) => (
						<li class="text-base font-medium leading-relaxed text-text-inverse">
							{bullet}
						</li>
					))
				}
			</ul>
			<p class="mt-6 text-base leading-relaxed text-text-inverse/90">
				{leadershipConnection.closing}
			</p>
			<p class="mt-4 font-display text-lg font-semibold text-text-inverse">
				{leadershipConnection.tagline}
			</p>
		</div>
	</Section>

	<Section>
		<div class="mx-auto max-w-3xl">
			<h2
				class="text-balance font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
			>
				{forLeaders.title}
			</h2>
			<div class="mt-6 space-y-2 text-base leading-relaxed text-text">
				{
					forLeaders.paragraphs.map((paragraph) => (
						<p>{paragraph}</p>
					))
				}
			</div>
			<ul class="mt-6 space-y-2" role="list">
				{
					forLeaders.considerations.map((item) => (
						<li class="flex gap-2.5 text-base leading-relaxed text-text">
							<span
								class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"
								aria-hidden="true"
							/>
							{item}
						</li>
					))
				}
			</ul>
			<p class="mt-6 text-base leading-relaxed text-text">{forLeaders.closing}</p>
		</div>
	</Section>

	<Section variant="muted">
		<div class="mx-auto max-w-3xl">
			<h2
				class="text-balance font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
			>
				{forFamilies.title}
			</h2>
			<div class="mt-6 space-y-4 text-base leading-relaxed text-text">
				{
					forFamilies.paragraphs.map((paragraph) => (
						<p>{paragraph}</p>
					))
				}
			</div>
		</div>
	</Section>

	<Section>
		<div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
			<div>
				<h2
					class="font-display text-h2 font-h2 uppercase tracking-h2 text-brand"
				>
					{whatYoullFind.title}
				</h2>
				<p class="mt-4 text-base leading-relaxed text-text">{whatYoullFind.intro}</p>
				<p class="mt-4 font-display text-sm font-semibold uppercase tracking-wide text-text-heading">
					You&rsquo;ll explore how to:
				</p>
			</div>
			<ul class="space-y-3" role="list">
				{
					whatYoullFind.outcomes.map((outcome) => (
						<li class="flex gap-3 text-sm leading-relaxed text-text sm:text-base">
							<span
								class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-brand"
								aria-hidden="true"
							/>
							{outcome}
						</li>
					))
				}
			</ul>
		</div>
	</Section>

	<Section variant="muted">
		<SectionHeading title={whoIsItFor.title} centered class="mb-10" />
		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
			{
				whoIsItFor.audiences.map((audience) => (
					<article class="border-t-2 border-brand bg-surface px-5 py-5 shadow-sm sm:px-6 sm:py-6">
						<h3 class="font-display text-h4 font-semibold leading-snug text-text-heading">
							{audience.title}
						</h3>
						<p class="mt-3 text-sm leading-relaxed text-text sm:text-base">
							{audience.description}
						</p>
					</article>
				))
			}
		</div>
	</Section>

	<Section id="book">
		<div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
			<div class="flex justify-center lg:order-2">
				<div class="overflow-hidden rounded-sm shadow-lg">
					<Image
						src={bookCover}
						alt="Relationship Matters book cover"
						width={bookCover.width}
						height={bookCover.height}
						class="h-auto w-full max-w-xs object-cover"
						loading="lazy"
					/>
				</div>
			</div>
			<div class="lg:order-1">
				<h2
					class="font-display text-h2 font-h2 uppercase tracking-h2 text-brand"
				>
					{bookSection.title}
				</h2>
				<p class="mt-3 font-display text-lg font-semibold text-text-heading">
					{bookSection.subtitle}
				</p>
				<p class="mt-4 text-base leading-relaxed text-text">{bookSection.copy}</p>
				<div class="mt-8">
					<Button href="#retailers">{bookSection.cta}</Button>
				</div>
			</div>
		</div>
	</Section>

	<BookRetailerGrid retailers={bookRetailers} id="retailers" />

	<Section variant="muted" aria-labelledby="course-section-heading">
		<div class="mx-auto max-w-2xl text-center">
			<h2
				id="course-section-heading"
				class="font-display text-h2 font-h2 uppercase tracking-h2 text-brand"
			>
				{courseSection.title}
			</h2>
			<p class="mt-4 text-base leading-relaxed text-text">{courseSection.body}</p>
			<div class="mt-6">
				<Button href={courseSection.href}>{courseSection.cta}</Button>
			</div>
		</div>
	</Section>

	<Section aria-labelledby="speaking-section-heading">
		<div class="mx-auto max-w-3xl">
			<h2
				id="speaking-section-heading"
				class="text-balance text-center font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
			>
				{speakingSection.title}
			</h2>
			<p class="mt-6 text-center text-base leading-relaxed text-text">{speakingSection.body}</p>
			<ul class="mt-6 flex flex-wrap justify-center gap-3" role="list">
				{
					speakingSection.topics.map((topic) => (
						<li class="rounded-full border border-brand/30 bg-surface-muted px-4 py-2 font-display text-sm font-semibold text-text-heading">
							{topic}
						</li>
					))
				}
			</ul>
			<div class="mt-8 text-center">
				<Button href={speakingSection.href}>{speakingSection.cta}</Button>
			</div>
		</div>
	</Section>

	<CourseTestimonialBand {...bookTestimonial} heading="What People Are Saying" />

	<Section>
		<div class="mx-auto max-w-3xl text-center">
			<h2
				class="text-balance font-display text-h3 font-semibold leading-snug text-text-heading sm:text-h2 sm:leading-tight"
			>
				{finalCta.title}
			</h2>
			<div class="mt-6 space-y-1">
				{
					finalCta.lines.map((line) => (
						<p class="text-base leading-relaxed text-text">{line}</p>
					))
				}
			</div>
			<p class="mt-6 text-base leading-relaxed text-text">{finalCta.body}</p>
			<div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
				<Button href="#retailers">{finalCta.primaryCta}</Button>
				<Button href={finalCta.secondaryHref} variant="secondary">
					{finalCta.secondaryCta}
				</Button>
			</div>
		</div>
	</Section>
</BaseLayout>
