---
export const prerender = true;

import type { ImageMetadata } from 'astro';
import CourseCatalogCard from '@/components/courses/CourseCatalogCard.astro';
import CourseCatalogHero from '@/components/courses/CourseCatalogHero.astro';
import CourseCatalogValueProps from '@/components/courses/CourseCatalogValueProps.astro';
import FeaturedCourse from '@/components/courses/FeaturedCourse.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import NewsletterCta from '@/components/sections/NewsletterCta.astro';
import Section from '@/components/ui/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { catalogHero, catalogValueProps } from '@/data/online-courses';
import { getAllCourses, getLowestCoursePrice } from '@/lib/courses';

const courses = await getAllCourses();
const featured = courses.find((course) => course.data.featured) ?? courses[0];
const others = courses.filter((course) => course.id !== featured?.id);
const accessDays = featured?.data.accessDays ?? 365;

const coverImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/courses/**/*.{png,jpg,jpeg,webp}', {
	eager: true,
});

function getCover(slug: string, filename: string): ImageMetadata | undefined {
	const key = Object.keys(coverImages).find((path) => path.includes(`/courses/${slug}/`) && path.endsWith(`/${filename}`));
	return key ? coverImages[key].default : undefined;
}

const featuredCover = featured ? getCover(featured.id, featured.data.coverImage) : undefined;
const otherCourses = others.map((course) => ({
	course,
	cover: getCover(course.id, course.data.coverImage),
}));
---

<BaseLayout
	title="Online Courses"
	description="Video courses on relationships, confidence, anger, and shame — taught by Mark Gordon. Relationship Matters, Godfidence, and more."
>
	<CourseCatalogHero
		title={catalogHero.title}
		subtitle={catalogHero.subtitle}
		hook={catalogHero.hook}
		courseCount={courses.length}
		lowestPrice={getLowestCoursePrice(courses)}
		accessDays={accessDays}
	/>

	<CourseCatalogValueProps items={catalogValueProps} />

	<Section id="featured-course">
		{featured && <FeaturedCourse course={featured} cover={featuredCover} />}
	</Section>

	{
		otherCourses.length > 0 && (
			<Section variant="muted">
				<h2 class="mb-2 font-display text-h2 font-h2 uppercase tracking-h2 text-brand">More courses</h2>
				<p class="mb-8 max-w-2xl text-sm leading-relaxed text-text-muted">
					Focused video series on confidence, anger, and shame — each with a full year of access.
				</p>
				<div class="grid gap-6 lg:grid-cols-2 lg:gap-8">
					{otherCourses.map(({ course, cover }) => (
						<CourseCatalogCard {course} {cover} compact />
					))}
				</div>
			</Section>
		)
	}

	<CtaBand />
	<NewsletterCta />
</BaseLayout>
