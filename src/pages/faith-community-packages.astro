---
export const prerender = true;

import FaithCommunityBookingClose from '@/components/sections/faith/FaithCommunityBookingClose.astro';
import FaithCommunityHero from '@/components/sections/faith/FaithCommunityHero.astro';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import {
	faithCommunityTestimonials,
	faithPackages,
	faithCommunitySeo,
	smallGroupPackage,
} from '@/data/faith-community-packages';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { hubspot } from '@/config/site';
---

<BaseLayout title={faithCommunitySeo.title} description={faithCommunitySeo.description}>
	<FaithCommunityHero />

	<Section id="faith-packages" variant="muted" class="scroll-mt-24">
		<SectionHeading
			title="Packages"
			subtitle="Ongoing training and tools for healthy relational culture."
			class="mb-10"
		/>

		<div class="grid gap-6 lg:grid-cols-2 lg:gap-8">
			{
				faithPackages.map((pkg) => (
					<article
						class:list={[
							'border-t-2 bg-surface px-5 py-6 shadow-sm sm:px-6 sm:py-8',
							pkg.variant === 'brand' ? 'border-brand' : 'border-text-heading/40',
						]}
					>
						<h2 class="font-display text-h4 font-semibold leading-snug text-text-heading">
							{pkg.title}
						</h2>
						<p class="mt-4 text-base leading-relaxed text-text">{pkg.description}</p>
						<p class="mt-4 text-base font-semibold text-text-heading">This package includes:</p>
						<ul class="mt-3 space-y-2" role="list">
							{
								pkg.includes.map((item) => (
									<li class="flex gap-2.5 text-base leading-relaxed text-text">
										<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true" />
										<span>{item}</span>
									</li>
								))
							}
						</ul>
						<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
							<Button href={hubspot.discoveryCall} external class="w-full sm:w-auto">
								{pkg.ctaLabel}
							</Button>
							<Button href="/contact/" variant="secondary" class="w-full sm:w-auto">
								Ask a Question
							</Button>
						</div>
						{
							pkg.footnotes && (
								<div class="mt-4 space-y-1">
									{pkg.footnotes.map((note) => (
										<p class="text-sm italic text-text-muted">{note}</p>
									))}
								</div>
							)
						}
					</article>
				))
			}
		</div>
	</Section>

	<Section>
		<article class="border-t-2 border-text-heading/40 bg-surface px-5 py-6 shadow-sm sm:px-8 sm:py-8">
			<h2 class="font-display text-h4 font-semibold leading-snug text-text-heading">
				{smallGroupPackage.title}
			</h2>
			{
				smallGroupPackage.paragraphs.map((paragraph, index) => (
					<p class:list={['text-base leading-relaxed text-text', index > 0 && 'mt-4']}>
						{paragraph}
					</p>
				))
			}
			<p class="mt-4 text-base font-semibold text-text-heading">This package includes:</p>
			<ul class="mt-3 space-y-2" role="list">
				{
					smallGroupPackage.includes.map((item) => (
						<li class="flex gap-2.5 text-base leading-relaxed text-text">
							<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true" />
							<span>{item}</span>
						</li>
					))
				}
			</ul>
			<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
				<Button href={hubspot.discoveryCall} external class="w-full sm:w-auto">
					{smallGroupPackage.ctaLabel}
				</Button>
				<Button href="/contact/" variant="secondary" class="w-full sm:w-auto">
					Ask a Question
				</Button>
			</div>
		</article>
	</Section>

	<Section variant="muted" aria-labelledby="faith-testimonials-heading">
		<SectionHeading title="Testimonials" class="mb-10" />
		<div class="grid gap-8 sm:grid-cols-2">
			{
				faithCommunityTestimonials.map((testimonial) => (
					<blockquote class="min-w-0 text-base leading-relaxed text-text">
						<p>&ldquo;{testimonial.quote}&rdquo;</p>
						<cite class="mt-4 block text-sm not-italic text-text-muted">{testimonial.author}</cite>
					</blockquote>
				))
			}
		</div>
	</Section>

	<FaithCommunityBookingClose />
</BaseLayout>
