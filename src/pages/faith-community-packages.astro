---
export const prerender = true;

import { Image } from 'astro:assets';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import NewsletterCta from '@/components/sections/NewsletterCta.astro';
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import {
	faithCommunityCollage,
	faithCommunityIntro,
	faithCommunityTestimonials,
	faithPackages,
	smallGroupPackage,
} from '@/data/faith-community-packages';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { hubspot, site } from '@/config/site';

const description = `Faith Community Packages — ${site.tagline}`;
---

<BaseLayout title="Faith Community Packages" description={description}>
	<Section>
		<div class="grid items-start gap-10 lg:grid-cols-2 lg:gap-12">
			<div class="grid grid-cols-[0.85fr_1fr] gap-2 sm:gap-3">
				{
					faithCommunityCollage.map((column) => (
						<div class="flex flex-col gap-2 sm:gap-3">
							{column.map(({ image, size, align }) => (
								<div
									class:list={[
										size === 'small' ? 'w-[45%]' : 'w-full',
										align === 'right' && 'ml-auto',
									]}
								>
									<Image
										src={image}
										alt=""
										width={image.width}
										height={image.height}
										class="h-auto w-full"
										loading="eager"
									/>
								</div>
							))}
						</div>
					))
				}
			</div>

			<div>
				<p
					class="font-display text-[length:var(--text-eyebrow)] font-semibold uppercase tracking-[var(--tracking-eyebrow)] text-brand"
				>
					Faith communities
				</p>
				<h1
					class="mt-2 text-balance font-display text-[length:var(--text-hero)] font-[number:var(--font-weight-hero)] leading-[var(--text-hero--line-height)] tracking-[var(--tracking-hero)] text-text-heading"
				>
					Faith Community Packages
				</h1>
				<p class="mt-4 font-display text-h4 font-semibold leading-snug text-text-heading">
					Choose the plan that's right for you.
				</p>
				{
					faithCommunityIntro.paragraphs.map((paragraph) => (
						<p class="mt-4 text-base leading-relaxed text-text">{paragraph}</p>
					))
				}
				<ul class="mt-4 space-y-2" role="list">
					{
						faithCommunityIntro.audienceAreas.map((item) => (
							<li class="flex gap-2.5 text-base leading-relaxed text-text">
								<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true" />
								<span>{item}</span>
							</li>
						))
					}
				</ul>
				<p class="mt-4 text-base leading-relaxed text-text">
					{faithCommunityIntro.closing}
				</p>
				<div class="mt-8">
					<Button href={hubspot.discoveryCall} external class="w-full justify-center sm:w-auto">
						Book Discovery Call
					</Button>
				</div>
			</div>
		</div>
	</Section>

	<Section variant="muted">
		<SectionHeading title="Packages" subtitle="Ongoing training and tools for healthy relational culture." class="mb-10" />

		<div class="grid gap-6 lg:grid-cols-2 lg:gap-8">
			{
				faithPackages.map((pkg) => (
					<article
						class:list={[
							'border-t-2 bg-surface px-5 py-6 shadow-sm sm:px-6 sm:py-8',
							pkg.variant === 'brand' ? 'border-brand' : 'border-text-heading/40',
						]}
					>
						<h2 class="font-display text-h4 font-semibold leading-snug text-text-heading">
							{pkg.title}
						</h2>
						<p class="mt-4 text-base leading-relaxed text-text">{pkg.description}</p>
						<p class="mt-4 text-base font-semibold text-text-heading">This package includes:</p>
						<ul class="mt-3 space-y-2" role="list">
							{
								pkg.includes.map((item) => (
									<li class="flex gap-2.5 text-base leading-relaxed text-text">
										<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true" />
										<span>{item}</span>
									</li>
								))
							}
						</ul>
						<div class="mt-8">
							<Button href={hubspot.discoveryCall} external class="w-full justify-center sm:w-auto">
								{pkg.ctaLabel}
							</Button>
						</div>
						{
							pkg.footnotes && (
								<div class="mt-4 space-y-1">
									{pkg.footnotes.map((note) => (
										<p class="text-sm italic text-text-muted">{note}</p>
									))}
								</div>
							)
						}
					</article>
				))
			}
		</div>
	</Section>

	<Section>
		<article class="border-t-2 border-text-heading/40 bg-surface px-5 py-6 shadow-sm sm:px-8 sm:py-8">
			<h2 class="font-display text-h4 font-semibold leading-snug text-text-heading">
				{smallGroupPackage.title}
			</h2>
			{
				smallGroupPackage.paragraphs.map((paragraph, index) => (
					<p class:list={['text-base leading-relaxed text-text', index > 0 && 'mt-4']}>
						{paragraph}
					</p>
				))
			}
			<p class="mt-4 text-base font-semibold text-text-heading">This package includes:</p>
			<ul class="mt-3 space-y-2" role="list">
				{
					smallGroupPackage.includes.map((item) => (
						<li class="flex gap-2.5 text-base leading-relaxed text-text">
							<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true" />
							<span>{item}</span>
						</li>
					))
				}
			</ul>
			<div class="mt-8">
				<Button href={hubspot.discoveryCall} external>
					{smallGroupPackage.ctaLabel}
				</Button>
			</div>
		</article>
	</Section>

	<Section variant="muted" aria-labelledby="faith-testimonials-heading">
		<SectionHeading title="Testimonials" class="mb-10" />
		<div class="grid gap-8 sm:grid-cols-2">
			{
				faithCommunityTestimonials.map((testimonial) => (
					<blockquote class="min-w-0 text-base leading-relaxed text-text">
						<p>{testimonial.quote}</p>
						<cite class="mt-4 block text-sm not-italic text-text-muted">{testimonial.author}</cite>
					</blockquote>
				))
			}
		</div>
	</Section>

	<NewsletterCta />
</BaseLayout>
